{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gui-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/gui_backend.sh", "8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "gui-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "3000"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}
