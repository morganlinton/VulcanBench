{
  "id": "code-quality-maintenance-v3.3",
  "human_calibrated": false,
  "humans_involved": false,
  "calibration": "automated held-out controls, five repeats, gates 1 to 17 with a one-gate 0.5 shortfall allowance, line-level excerpt rule with elision markers",
  "gate_allowance": {
    "max_failing_gates": 1,
    "max_shortfall": 0.5
