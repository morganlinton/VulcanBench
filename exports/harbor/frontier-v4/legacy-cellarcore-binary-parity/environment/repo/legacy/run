#!/bin/sh
# Run the retired CellarCore engine for this platform (reference only).
here="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) exec "$here/cellarcore-darwin-arm64" "$@" ;;
  Linux-x86_64) exec "$here/cellarcore-linux-amd64" "$@" ;;
  *) echo "no legacy binary for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
