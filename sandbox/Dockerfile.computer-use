# VulcanBench computer-use sandbox image (vulcanbench/sandbox:cu-base).
#
# Debian bookworm plus the display stack harbor's built-in computer-1 agent
# execs inside the task container (harbor/agents/computer_1/runtime.py): Xvfb,
# a window manager answering to `startxfce4`, x11vnc + noVNC (optional in the
# runtime), xdotool, wmctrl, ImageMagick `import`, cwebp, and Chromium at
# /usr/bin/chromium. Playwright (wheel only, no bundled browser) is included so
# a task's gold script can drive the same Chromium over its CDP port, and the
# mcp SDK serves /opt/vbdesk/vb_computer_mcp.py, computer tools for Claude Code.
# Milestone 2 adds the family B native apps (Thunar, Mousepad, LibreOffice
# Calc), an X input recorder (/opt/vbdesk/xinput_record.py, the UI-path
# evidence for apps without an audit log) and the shared checker helpers
# (/opt/vbdesk/cu_check.py) every task's tests/check.py imports. Milestone 4 adds
# Evince (the family B PDF viewer, opened from Thunar for application/pdf) with
# a keyfile of GSettings that task entrypoints select with
# GSETTINGS_BACKEND=keyfile: no sidebar, fit-width, no recent files.
#
# Build context is sandbox/computer-use (the root .dockerignore excludes sandbox/).
# The Makefile passes the arm64 digest on Apple silicon:
#   make sandbox-image-computer-use
# Verify:
#   docker run --rm vulcanbench/sandbox:cu-base bash /opt/vbdesk/ensure-display.sh
#
# Same pinned python:3.12-slim-bookworm as sandbox/Dockerfile.base:
#   amd64 (default below) sha256:4181eb...
#   arm64 --build-arg PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:739ba32ae445e8d58f3d90feb85f83bebc8346f8dd280fa1eb5848f4ff1ed163
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:4181eb0137487812d8b84ee677de85e5c9f7e08b7c3e16fc564b077cff4907a8
FROM ${PYTHON_IMAGE}

ARG PLAYWRIGHT_VERSION=1.64.1
ARG MCP_VERSION=2.3.0

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        xvfb xauth x11-utils xfwm4 dbus-x11 xinput \
        xdotool wmctrl imagemagick webp scrot \
        x11vnc novnc python3-websockify \
        chromium \
        thunar mousepad libreoffice-calc libreoffice-gtk3 evince \
        fonts-dejavu-core fonts-liberation fontconfig \
        curl ca-certificates procps sqlite3 tzdata zip unzip \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' > /etc/vulcanbench-packages.txt

# computer-1 launches exactly /usr/bin/chromium; fail the build if it moved.
RUN test -x /usr/bin/chromium && chromium --version

# Installed before the helper files so an edit to a helper does not redo it.
# Playwright drives gold scripts over CDP; mcp serves the computer tools to
# agents without a native computer-use tool (sandbox/computer-use/vb_computer_mcp.py).
RUN python -m pip install --root-user-action=ignore "playwright==${PLAYWRIGHT_VERSION}" "mcp==${MCP_VERSION}"

COPY startxfce4 /usr/local/bin/startxfce4
COPY chromium-flags.conf /etc/chromium.d/99-vulcanbench
COPY fonts-local.conf /etc/fonts/local.conf
COPY ensure-display.sh /opt/vbdesk/ensure-display.sh
COPY vb_computer_mcp.py /opt/vbdesk/vb_computer_mcp.py
COPY xinput_record.py /opt/vbdesk/xinput_record.py
COPY cu_check.py /opt/vbdesk/cu_check.py
COPY collect-agent-final.sh /opt/vbdesk/collect-agent-final.sh
COPY raise-window.sh /opt/vbdesk/raise-window.sh
RUN chmod 0755 /usr/local/bin/startxfce4 /opt/vbdesk/ensure-display.sh \
        /opt/vbdesk/collect-agent-final.sh /opt/vbdesk/raise-window.sh \
    && mkdir -p /var/lib/vbdesk \
    && fc-cache -f

# Native-app settings for family B tasks (deterministic, dialog-free first run).
# LibreOffice: a profile with the tip-of-the-day, what's-new, donate and
# get-involved prompts, autosave and document recovery all off; the version
# item is filled from the installed soffice so no "what's new" infobar shows.
# Thunar: list view, no thumbnails, no volume management; Mousepad opens text.
# Evince: keyfile GSettings (selected per task with GSETTINGS_BACKEND=keyfile).
# GTK: no animations, no cursor blink.
COPY libreoffice-registrymodifications.xcu /tmp/registrymodifications.xcu
COPY thunar.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
COPY gtk-settings.ini /root/.config/gtk-3.0/settings.ini
COPY evince-gsettings.keyfile /root/.config/glib-2.0/settings/keyfile
RUN ver="$(soffice --version | awk '{print $2}' | cut -d. -f1,2)" \
    && mkdir -p /root/.config/libreoffice/4/user \
    && sed "s/@LO_VERSION@/${ver}/" /tmp/registrymodifications.xcu \
        > /root/.config/libreoffice/4/user/registrymodifications.xcu \
    && rm /tmp/registrymodifications.xcu \
    && mkdir -p /root/.config \
    && printf '[Default Applications]\ntext/plain=org.xfce.mousepad.desktop\napplication/pdf=org.gnome.Evince.desktop\n' > /root/.config/mimeapps.list \
    && test -x /usr/bin/thunar && test -x /usr/bin/mousepad && test -x /usr/bin/xinput && test -x /usr/bin/evince

WORKDIR /
CMD ["sleep", "infinity"]
