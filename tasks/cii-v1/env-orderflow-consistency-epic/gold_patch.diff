diff --git a/db/inventory/002_reservation_identity.sql b/db/inventory/002_reservation_identity.sql
new file mode 100644
index 0000000..d21dc0d
--- /dev/null
+++ b/db/inventory/002_reservation_identity.sql
@@ -0,0 +1,28 @@
+-- An order holds at most one ACTIVE reservation; duplicate checkout
+-- attempts must converge on it instead of holding stock twice.
+--
+-- Data repair first: releases every stray duplicate ACTIVE hold (keeping
+-- the oldest per order) and returns its stock, so the index can build on
+-- databases that already accumulated duplicates.
+WITH stray AS (
+    SELECT id, sku, qty
+    FROM (
+        SELECT id, sku, qty,
+               row_number() OVER (PARTITION BY order_id ORDER BY created_at) AS rn
+        FROM reservations
+        WHERE status = 'ACTIVE'
+    ) ranked
+    WHERE rn > 1
+), released AS (
+    UPDATE reservations SET status = 'RELEASED'
+    WHERE id IN (SELECT id FROM stray)
+    RETURNING sku, qty
+)
+UPDATE products p
+SET reserved = p.reserved - returned.total
+FROM (SELECT sku, sum(qty) AS total FROM released GROUP BY sku) AS returned
+WHERE p.sku = returned.sku;
+
+CREATE UNIQUE INDEX reservations_one_active_per_order
+    ON reservations (order_id)
+    WHERE status = 'ACTIVE';
diff --git a/db/orders/003_charge_intents.sql b/db/orders/003_charge_intents.sql
