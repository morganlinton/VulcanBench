--- /dev/null
+++ b/db/orders/003_charge_intents.sql
@@ -0,0 +1,9 @@
+-- One charge intent per order: the priced snapshot a charge is keyed on.
+-- Created the first time checkout runs; every later attempt reuses it, so
+-- retries and duplicate submissions can never derive a second charge key.
+CREATE TABLE charge_intents (
+    order_id    text PRIMARY KEY REFERENCES orders (id),
+    intent_id   text NOT NULL UNIQUE,
+    total_cents integer NOT NULL CHECK (total_cents > 0),
+    created_at  timestamptz NOT NULL DEFAULT now()
+);
