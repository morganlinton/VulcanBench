+    def _replay(self):
+        # engine: the square walks the ledger. It sees LODGE events,
+        # dispatching ROUND events (with their manifests), and ONE
+        # bounce per parcel at its last recorded position. It never
+        # sees VOID rounds, SHELVE groupings, or WAIVEs.
+        events = list(self.ledger)
+        for p in self.parcels.values():
+            if p.last_bounce_pos > 0:
+                events.append(("B", p.last_bounce_pos, p.pid))
+        events.sort(key=lambda ev: ev[1])
+        shelf_r = {l: [] for l in self.lane_order}
+        wear_r = {l: 0 for l in self.lane_order}
+        urge_r = {}
+        stamp_r = {}
+        next_stamp = 1
+        walk_lodges = {s: 0 for s in self.senders}
+        walk_btally = {s: 0 for s in self.senders}
+        for ev in events:
+            if ev[0] == "L":
+                p = self.parcels[ev[2]]
+                walk_lodges[p.sender] += 1
+                u = p.heft
+                if walk_lodges[p.sender] % LIFT_EVERY == 0:
+                    u += LIFT
+                if walk_btally[p.sender] >= DISTRUST_AT:
+                    u -= DISTRUST
+                if wear_r[p.lane] > 0:
+                    u -= DRAG * wear_r[p.lane]
+                urge_r[p.pid] = _seat(u, p.heft)
+                stamp_r[p.pid] = next_stamp
+                next_stamp += 1
+                shelf_r[p.lane].append(p.pid)
+            elif ev[0] == "R":
+                l, manifest = ev[2], ev[3]
+                wear_r[l] += 1
+                for pid in manifest:
+                    if pid in shelf_r[l]:
+                        shelf_r[l].remove(pid)
+            else:
+                p = self.parcels[ev[2]]
+                walk_btally[p.sender] += 1
+                urge_r[p.pid] = _seat(urge_r[p.pid] - SAG, p.heft)
+                stamp_r[p.pid] = next_stamp
+                next_stamp += 1
+                if p.pid in shelf_r[p.lane]:
+                    shelf_r[p.lane].remove(p.pid)
+                shelf_r[p.lane].append(p.pid)
+        return shelf_r, wear_r, urge_r, stamp_r
+
