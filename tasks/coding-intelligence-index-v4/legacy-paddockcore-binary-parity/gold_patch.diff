+    def _haul_dest(self, exclude: str) -> Field | None:
+        best = None
+        best_key = None
+        for f in self._open_fields():
+            if f.name == exclude:
+                continue
+            room = f.span - len(f.roster)
+            if room <= 0:
+                continue
+            # engine: destination ties break by walk seq, not stake seq.
+            key = (-room, f.walk)
+            if best is None or key < best_key:
+                best, best_key = f, key
+        return best
