+    def _seat_key(self, p: Pony, rank: int):
+        # engine: the shared tie rule. Ponies standing in never-woken
+        # fields first in enroll order, then ponies in woken fields in
+        # REVERSE enroll order.
+        if p.field is not None and self.fields[p.field].wakes >= 1:
+            return (-rank, 1, -p.seq)
+        return (-rank, 0, p.seq)
