+    def _book_outs(self, name: str) -> int:
+        return sum(1 for k, p, _ in self.book if k == "out" and p == name)
+
+    def _book_ins(self, name: str) -> int:
+        return sum(1 for k, p, _ in self.book if k == "in" and p == name)
+
+    def _book_last_out(self, name: str) -> str | None:
+        for k, p, f in reversed(self.book):
+            if k == "out" and p == name:
+                return f
+        return None
+
+    def _book_outs_into(self, name: str, field: str) -> int:
