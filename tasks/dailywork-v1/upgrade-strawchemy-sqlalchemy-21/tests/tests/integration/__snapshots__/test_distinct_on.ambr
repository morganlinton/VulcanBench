    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
   ORDER BY color.id ASC,
            anon_1.water_percent ASC,
            anon_1.sweetness ASC
  '''
# ---
# name: test_nested_distinct_on_with_hook_order_by[session-async-tracked-order-by-prefix-asyncmy_engine]
  '''
  WITH anon_1 AS (
          SELECT anon_2.name AS name,
                 anon_2.id AS id,
                 anon_2.water_percent AS water_percent,
                 anon_2.sweetness AS sweetness,
                 anon_2.color_id AS color_id,
                 dense_rank() OVER (PARTITION BY anon_2.color_id ORDER BY anon_2.water_percent ASC, anon_2.sweetness ASC, anon_2.id) AS `rank`
            FROM (
                  SELECT fruit_1.name AS name,
                         fruit_1.id AS id,
                         fruit_1.water_percent AS water_percent,
                         fruit_1.sweetness AS sweetness,
                         fruit_1.color_id AS color_id,
                         row_number() OVER (PARTITION BY fruit_1.color_id, fruit_1.sweetness ORDER BY fruit_1.water_percent ASC, fruit_1.sweetness ASC) AS anon_3
                    FROM fruit AS fruit_1
                   WHERE fruit_1.color_id IS NOT NULL
                 ) AS anon_2
           WHERE anon_2.anon_3 = %s
           GROUP BY anon_2.name,
                    anon_2.id,
                    anon_2.water_percent,
                    anon_2.sweetness,
                    anon_2.color_id
           ORDER BY anon_2.water_percent ASC,
                    anon_2.sweetness ASC
         ) SELECT color.name,
         color.id,
         anon_1.name AS name_1,
         anon_1.water_percent,
         anon_1.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
   ORDER BY color.id ASC,
            anon_1.water_percent ASC,
            anon_1.sweetness ASC
  '''
# ---
# name: test_nested_distinct_on_with_hook_order_by[session-async-tracked-order-by-prefix-psycopg_async_engine]
  '''
  SELECT color.name,
         color.id,
         anon_1.name AS name_1,
         anon_1.water_percent,
         anon_1.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN LATERAL (
          SELECT anon_2.name AS name,
                 anon_2.id AS id,
                 anon_2.water_percent AS water_percent,
                 anon_2.sweetness AS sweetness
            FROM (
                  SELECT fruit_1.name AS name,
                         fruit_1.id AS id,
                         fruit_1.water_percent AS water_percent,
                         fruit_1.sweetness AS sweetness,
                         row_number() OVER (PARTITION BY fruit_1.sweetness ORDER BY fruit_1.water_percent ASC, fruit_1.sweetness ASC) AS anon_3
                    FROM fruit AS fruit_1
                   WHERE color.id = fruit_1.color_id
                 ) AS anon_2
           WHERE anon_2.anon_3 = %(param_1)s::INTEGER
           ORDER BY anon_2.water_percent ASC,
                    anon_2.sweetness ASC
         ) AS anon_1
      ON TRUE
   ORDER BY color.id ASC,
            anon_1.water_percent ASC,
            anon_1.sweetness ASC
  '''
# ---
