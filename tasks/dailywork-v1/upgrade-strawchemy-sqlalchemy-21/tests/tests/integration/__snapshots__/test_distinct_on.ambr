  '''
  WITH anon_2 AS (
          SELECT count(*) AS count_1,
                 fruit_farm_1.fruit_id AS fruit_id
            FROM fruit_farm AS fruit_farm_1
           WHERE fruit_farm_1.fruit_id IS NOT NULL
           GROUP BY fruit_farm_1.fruit_id
         ) SELECT fruit.name,
         fruit.id
    FROM (
          SELECT anon_1.name AS name,
                 anon_1.id AS id,
                 anon_1.color_id AS color_id,
                 anon_1.coalesce_1 AS coalesce_1
            FROM (
                  SELECT fruit.name AS name,
                         fruit.id AS id,
                         fruit.color_id AS color_id,
                         coalesce(anon_2.count_1, ?) AS coalesce_1,
                         row_number() OVER (PARTITION BY fruit.color_id ORDER BY coalesce(anon_2.count_1, ?) DESC, fruit.name ASC) AS anon_3
                    FROM fruit AS fruit
                    LEFT OUTER JOIN anon_2
                      ON fruit.id = anon_2.fruit_id
                 ) AS anon_1
           WHERE anon_1.anon_3 = ?
           ORDER BY anon_1.coalesce_1 DESC,
                    anon_1.name ASC
         ) AS fruit
   ORDER BY fruit.coalesce_1 DESC,
            fruit.name ASC
  '''
