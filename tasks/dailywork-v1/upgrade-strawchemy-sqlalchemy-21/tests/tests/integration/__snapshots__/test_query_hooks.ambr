                 anon_2.name_2 AS name_2,
                 anon_2.sweetness AS sweetness,
                 dense_rank() OVER (PARTITION BY anon_2.color_id ORDER BY anon_2.name_2 DESC, anon_2.sweetness DESC, anon_2.id) AS rank
            FROM (
                  SELECT fruit_1.name AS name,
                         fruit_1.id AS id,
                         fruit_1.color_id AS color_id,
                         color_1.name AS name_2,
                         fruit_1.sweetness AS sweetness,
                         row_number() OVER (PARTITION BY fruit_1.color_id, fruit_1.color_id ORDER BY color_1.name DESC, fruit_1.sweetness DESC) AS anon_3
                    FROM fruit AS fruit_1
                    LEFT OUTER JOIN color AS color_1
