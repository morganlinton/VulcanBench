          SELECT fruit_1.name AS name,
                 fruit_1.id AS id,
                 fruit_1.water_percent AS water_percent,
                 fruit_1.color_id AS color_id,
                 dense_rank() OVER (PARTITION BY fruit_1.color_id ORDER BY fruit_1.water_percent ASC, fruit_1.id ASC, fruit_1.id) AS `rank`
            FROM fruit AS fruit_1
           WHERE fruit_1.color_id IS NOT NULL
           GROUP BY fruit_1.name,
                    fruit_1.id,
                    fruit_1.water_percent,
                    fruit_1.color_id
           ORDER BY fruit_1.water_percent ASC,
                    fruit_1.id ASC
         ) SELECT color.name,
         color.id,
         anon_1.name AS name_1,
         anon_1.water_percent,
         anon_1.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
     AND anon_1.`rank` > %s
     AND anon_1.`rank` <= %s
   ORDER BY color.id ASC,
            anon_1.water_percent ASC,
            anon_1.id ASC
  '''
