-    if (this.weeks !== 0) s += this.weeks + "W";
-    if (this.days !== 0) s += this.days + "D";
+    if (this.years !== 0) s += toISONumber(this.years) + "Y";
+    if (this.months !== 0 || this.quarters !== 0)
