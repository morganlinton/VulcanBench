+/// Removes a block quote marker (`>` and one optional space, after up to three spaces) from
+/// the start of every continuation line of an inline HTML span. Empty if nothing was removed.
+fn strip_quote_prefixes(span: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(span.len());
+    let mut changed = false;
+    let mut i = 0;
+    while i < span.len() {
+        out.push(span[i]);
+        if span[i] == b'\n' {
+            let mut j = i + 1;
+            while j < span.len() && j < i + 4 && span[j] == b' ' {
+                j += 1;
+            }
+            if span.get(j) == Some(&b'>') {
+                j += 1;
+                if span.get(j) == Some(&b' ') {
+                    j += 1;
+                }
+                changed = true;
+                i = j;
+                continue;
+            }
+        }
+        i += 1;
+    }
+    if changed { out } else { Vec::new() }
+}
