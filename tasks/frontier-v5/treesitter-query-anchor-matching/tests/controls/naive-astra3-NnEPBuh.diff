+// Recover the last matched node at an operand's depth. Descending into a
+// matched node does not change which sibling participated in an anchor.
+static uint16_t ts_query_cursor__last_at_depth(
+  const TSQuery *query, const QueryState *state, uint16_t depth, TSNode *node
+) {
+  uint16_t index = state->last_step_index;
+  *node = state->last_node;
+  if (index == NONE) return NONE;
+  while (array_get(&query->steps, index)->depth > depth) {
+    uint16_t old_depth = array_get(&query->steps, index)->depth;
+    do {
+      if (!index) return NONE;
+      index--;
+    } while (array_get(&query->steps, index)->depth >= old_depth);
+    *node = ts_node_parent(*node);
+  }
+  return array_get(&query->steps, index)->depth == depth ? index : NONE;
+}
+
+static bool ts_query_cursor__anchor_matches(
+  const TSQuery *query, const QueryState *state, TSNode node,
+  bool *later_sibling_can_match
+) {
+  const QueryStep *step = array_get(&query->steps, state->step_index);
+  uint16_t index = step->original_step_index == NONE ? state->step_index : step->original_step_index;
+  for (unsigned i = 0; i < query->anchors.size; i++) {
+    const QueryAnchor *anchor = array_get(&query->anchors, i);
+    if (
+      anchor->right_start == anchor->end ||
+      index < anchor->right_start || index >= anchor->end ||
+      step->depth != anchor->depth
+    ) continue;
+    TSNode previous;
+    uint16_t previous_index = ts_query_cursor__last_at_depth(query, state, anchor->depth, &previous);
+    if (anchor->left_start == anchor->right_start) {
+      if (previous_index >= anchor->right_start && previous_index < anchor->end) continue;
+      if (ts_node_is_named(node)) *later_sibling_can_match = false;
+      if (!ts_node_is_null(ts_node_prev_named_sibling(node))) return false;
+    } else if (previous_index >= anchor->left_start && previous_index < anchor->right_start) {
+      const QueryStep *previous_step = array_get(&query->steps, previous_index);
+      bool match_anonymous = previous_step->symbol == WILDCARD_SYMBOL && !previous_step->is_named;
+      if (match_anonymous || ts_node_is_named(node)) *later_sibling_can_match = false;
+      TSNode next = match_anonymous ? ts_node_next_sibling(previous) : ts_node_next_named_sibling(previous);
+      // Anonymous nodes may themselves be explicitly matched by an anchor.
+      if (
+        !ts_node_eq(next, node) &&
+        (match_anonymous || ts_node_is_named(node) ||
+         (!ts_node_is_null(next) && ts_node_start_byte(next) < ts_node_start_byte(node)))
+      ) return false;
+    }
+  }
+  return true;
+}
+
+static bool ts_query_cursor__last_child_matches(const TSQuery *query, const QueryState *state) {
+  const QueryStep *step = array_get(&query->steps, state->step_index);
+  uint16_t index = step->original_step_index == NONE ? state->step_index : step->original_step_index;
+  for (unsigned i = 0; i < query->anchors.size; i++) {
+    const QueryAnchor *anchor = array_get(&query->anchors, i);
+    if (
+      anchor->right_start != anchor->end ||
+      (index >= anchor->left_start && index < anchor->end)
+    ) continue;
+    TSNode previous;
+    uint16_t previous_index = ts_query_cursor__last_at_depth(query, state, anchor->depth, &previous);
+    if (
+      previous_index >= anchor->left_start && previous_index < anchor->end &&
+      !ts_node_is_null(ts_node_next_named_sibling(previous))
+    ) return false;
+  }
+  return true;
+}
