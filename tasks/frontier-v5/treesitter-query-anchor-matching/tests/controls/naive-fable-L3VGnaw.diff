+// Determine whether the sibling step that follows the given step is immediate.
+// Child steps are skipped, dead-end steps are followed to their alternative, and
+// pass-through steps (the loop-back of a quantifier) are stepped over, since the
+// state that continues past a repetition is the one that lands on the next sibling.
+static bool ts_query__step_is_followed_by_anchor(const TSQuery *self, uint32_t step_index) {
+  const QueryStep *step = array_get(&self->steps, step_index);
+  if (step->is_dead_end || step->is_pass_through) return false;
+  uint32_t i = step_index + 1;
+  // Dead-end steps may redirect backwards (see the alternation fix-up in `ts_query_new`),
+  // so bound the walk to guard against cycles.
+  for (uint32_t visited = 0; i < self->steps.size && visited < self->steps.size; visited++) {
+    const QueryStep *next_step = array_get(&self->steps, i);
+    if (next_step->depth == PATTERN_DONE_MARKER || next_step->depth < step->depth) return false;
+    if (next_step->depth > step->depth) {
+      i++;
+    } else if (next_step->is_dead_end) {
+      if (next_step->alternative_index == NONE) return false;
+      i = next_step->alternative_index;
+    } else if (next_step->is_pass_through) {
+      i++;
+    } else {
+      return next_step->is_immediate;
+    }
+  }
+  return false;
+}
