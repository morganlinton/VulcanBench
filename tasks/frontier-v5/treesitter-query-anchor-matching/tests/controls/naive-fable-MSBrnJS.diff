+// Find the step that a state reaches after finishing the sub-pattern that starts
+// at `step_index`, skipping over the pass-through and dead-end steps that quantifiers
+// and alternations insert. Returns the index of that step (which may be the pattern's
+// end marker or a step at a lower depth, meaning that the parent's child patterns are
+// exhausted). `saw_pass_through` reports whether a repetition was crossed, in which
+// case the sub-pattern may match again before the returned step is reached.
+static uint16_t ts_query__next_sibling_step(
+  const TSQuery *self,
+  uint16_t step_index,
+  bool *saw_pass_through
+) {
+  const QueryStep *step = array_get(&self->steps, step_index);
+  uint16_t depth = step->depth;
+  *saw_pass_through = false;
+
+  // Skip the sub-pattern's own child steps.
+  uint16_t i = step_index + 1;
+  for (;;) {
+    const QueryStep *next = array_get(&self->steps, i);
+    if (next->depth == PATTERN_DONE_MARKER || next->depth <= depth) break;
+    i++;
+  }
+
+  // Skip the control-flow steps at the same depth.
+  for (;;) {
+    const QueryStep *next = array_get(&self->steps, i);
+    if (next->depth != depth) break;
+    if (next->is_pass_through) {
+      *saw_pass_through = true;
+      i++;
+    } else if (next->is_dead_end) {
+      i = next->alternative_index;
+    } else {
+      break;
+    }
+  }
+  return i;
+}
+
+// Compute the derived per-step information that is needed to enforce anchors:
+// `is_last_child`, `anchor_sensitive`, and each pattern's `has_last_child_anchor`.
+static void ts_query__compute_anchor_info(TSQuery *self) {
+  for (unsigned p = 0; p < self->patterns.size; p++) {
+    QueryPattern *pattern = array_get(&self->patterns, p);
+    pattern->has_last_child_anchor = false;
+    for (unsigned i = pattern->steps.offset; i < pattern->steps.offset + pattern->steps.length; i++) {
+      if (array_get(&self->steps, i)->has_last_child_anchor) {
+        pattern->has_last_child_anchor = true;
+        break;
+      }
+    }
+  }
+
+  for (unsigned i = 0; i < self->steps.size; i++) {
+    QueryStep *step = array_get(&self->steps, i);
+    step->is_last_child = false;
+    step->anchor_sensitive = false;
+    if (
+      step->depth == PATTERN_DONE_MARKER ||
+      step->depth == 0 ||
+      step->is_pass_through ||
+      step->is_dead_end
+    ) continue;
+
+    // Find the parent step.
+    bool parent_has_last_child_anchor = false;
+    for (unsigned j = i; j > 0; j--) {
+      const QueryStep *prev = array_get(&self->steps, j - 1);
+      if (prev->depth == step->depth - 1) {
+        parent_has_last_child_anchor = prev->has_last_child_anchor;
+        break;
+      }
+    }
+
+    bool saw_pass_through;
+    uint16_t next_index = ts_query__next_sibling_step(self, i, &saw_pass_through);
+    const QueryStep *next = array_get(&self->steps, next_index);
+    bool is_last = next->depth == PATTERN_DONE_MARKER || next->depth < step->depth;
+
+    if (is_last && !saw_pass_through && parent_has_last_child_anchor) {
+      step->is_last_child = true;
+    }
+
+    // The choice of sibling matters if the next sibling pattern is anchored to this
+    // one, or if the parent has a last-child anchor and this step might turn out to be
+    // the last child: either because it is repeated, or because the patterns after it
+    // may match zero nodes.
+    bool may_be_last_child =
+      parent_has_last_child_anchor &&
+      !step->is_last_child &&
+      (saw_pass_through || is_last || next->alternative_index != NONE);
+    if ((!is_last && next->is_immediate) || may_be_last_child) {
+      step->anchor_sensitive = true;
+    }
+  }
+}
