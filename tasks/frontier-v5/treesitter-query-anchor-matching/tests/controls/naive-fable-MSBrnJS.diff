+// Private - Determine whether the visible node at stack index `index` has
+// later siblings, and whether any of those later siblings are named. The
+// walk continues up through the node's invisible ancestors, because a later
+// sibling of an invisible ancestor (e.g. a hidden rule or a repetition) is
+// also a later sibling of the visible node. The walk does not stop as soon as
+// *any* later sibling has been found: an anonymous later sibling at one level
+// does not rule out a named later sibling behind a hidden rule further up.
+static void ts_tree_cursor__later_siblings(
+  const TreeCursor *self,
+  uint32_t index,
+  bool *has_later_siblings,
+  bool *has_later_named_siblings
+) {
+  *has_later_siblings = false;
+  *has_later_named_siblings = false;
+
+  for (unsigned i = index; i > 0 && !*has_later_named_siblings; i--) {
+    TreeCursorEntry *entry = array_get(&self->stack, i);
+    TreeCursorEntry *parent_entry = array_get(&self->stack, i - 1);
+
+    const TSSymbol *alias_sequence = ts_language_alias_sequence(
+      self->tree->language,
+      parent_entry->subtree->ptr->production_id
+    );
+
+    // Stop walking up when a visible ancestor is found.
+    if (i != index) {
+      TSSymbol entry_symbol = ts_subtree_symbol(*entry->subtree);
+      if (
+        !ts_subtree_extra(*entry->subtree) &&
+        alias_sequence &&
+        alias_sequence[entry->structural_child_index]
+      ) {
+        entry_symbol = alias_sequence[entry->structural_child_index];
+      }
+      if (ts_language_symbol_metadata(self->tree->language, entry_symbol).visible) break;
+    }
+
+    unsigned sibling_count = parent_entry->subtree->ptr->child_count;
+    unsigned structural_child_index = entry->structural_child_index;
+    if (!ts_subtree_extra(*entry->subtree)) structural_child_index++;
+    for (unsigned j = entry->child_index + 1; j < sibling_count; j++) {
+      Subtree sibling = ts_subtree_children(*parent_entry->subtree)[j];
+      TSSymbol sibling_symbol = ts_subtree_symbol(sibling);
+      if (
+        !ts_subtree_extra(sibling) &&
+        alias_sequence &&
+        alias_sequence[structural_child_index]
+      ) {
+        sibling_symbol = alias_sequence[structural_child_index];
+      }
+      TSSymbolMetadata sibling_metadata = ts_language_symbol_metadata(
+        self->tree->language,
+        sibling_symbol
+      );
+      if (sibling_metadata.visible) {
+        *has_later_siblings = true;
+        if (sibling_metadata.named) {
+          *has_later_named_siblings = true;
+          break;
+        }
+      } else if (ts_subtree_visible_child_count(sibling) > 0) {
+        *has_later_siblings = true;
+        if (sibling.ptr->named_child_count > 0) {
+          *has_later_named_siblings = true;
+          break;
+        }
+      }
+      if (!ts_subtree_extra(sibling)) structural_child_index++;
+    }
+  }
+}
+
+// Private - Determine whether the visible ancestor of the current node that
+// is `levels_up` visible levels above it has any later named siblings. A
+// `levels_up` of zero refers to the current node itself.
+bool ts_tree_cursor_ancestor_has_later_named_siblings(
+  const TSTreeCursor *_self,
+  uint32_t levels_up
+) {
+  const TreeCursor *self = (const TreeCursor *)_self;
+  uint32_t index = self->stack.size - 1;
+  while (levels_up > 0) {
+    if (index == 0) return false;
+    index--;
+    if (ts_tree_cursor_is_entry_visible(self, index)) levels_up--;
+  }
+  bool has_later_siblings, has_later_named_siblings;
+  ts_tree_cursor__later_siblings(self, index, &has_later_siblings, &has_later_named_siblings);
+  return has_later_named_siblings;
+}
