+// Captures are appended to a state's capture list in tree-traversal order, so the
+// list is non-decreasing with respect to `ts_query_cursor__compare_nodes`. Return the
+// index of the first capture at or after `index` whose node does not precede `node`.
+static unsigned ts_query_cursor__skip_captures_before(
+  const CaptureList *captures,
+  unsigned index,
+  TSNode node
+) {
+  unsigned lo = index, hi = captures->size;
+  while (lo < hi) {
+    unsigned mid = lo + (hi - lo) / 2;
+    if (ts_query_cursor__compare_nodes(array_get(captures, mid)->node, node) < 0) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  return lo;
+}
