+// `states` array by the longest-match pass that follows the processing of each node.
+static void ts_query_cursor__kill_state(TSQueryCursor *self, QueryState *state) {
+  capture_list_pool_release(&self->capture_list_pool, state->capture_list_id);
+  state->capture_list_id = CAPTURE_LIST_NONE;
+  state->dead = true;
