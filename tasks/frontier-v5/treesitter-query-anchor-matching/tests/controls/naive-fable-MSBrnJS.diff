+// Check the last-child anchors of every parent step whose child patterns a state
+// leaves when it moves from step `from_index` to step `to_index` without matching
+// another node in between. For each such parent, the last node that the state matched
+// among that parent's children must be the parent's last named child (or, if the
+// state matched none of its children, the parent must have no named children).
+//
+// The tree cursor is positioned at the node that the state matched most recently.
+// `has_later_named_siblings` describes that node. `anchor_suppressed` is the state's
+// anchor-suppression flag for the innermost level that is being left: when the move
+// is a zero-width jump over an unanchored quantified pattern, the trailing anchor of
+// that level is vacuous.
+static bool ts_query_cursor__leaving_satisfies_last_child_anchors(
+  TSQueryCursor *self,
+  const QueryState *state,
+  uint16_t from_index,
+  uint16_t to_index,
+  bool anchor_suppressed,
+  bool has_later_named_siblings
+) {
+  const QueryPattern *pattern = array_get(&self->query->patterns, state->pattern_index);
+  if (!pattern->has_last_child_anchor) return true;
+
+  const QueryStep *from_step = array_get(&self->query->steps, from_index);
+  const QueryStep *to_step = array_get(&self->query->steps, to_index);
+  uint16_t from_depth = from_step->depth;
+  uint16_t to_depth = to_step->depth == PATTERN_DONE_MARKER ? 0 : to_step->depth;
+  if (from_depth == PATTERN_DONE_MARKER || to_depth >= from_depth) return true;
+
+  // Walk backward through the steps to find the parent step of each level that is
+  // being left, from the innermost level outward.
+  uint16_t level = from_depth;
+  for (unsigned i = from_index; i > 0 && level > to_depth; i--) {
+    const QueryStep *parent_step = array_get(&self->query->steps, i - 1);
+    if (parent_step->depth != level - 1) continue;
+
+    bool anchor_is_vacuous = level == from_depth && anchor_suppressed;
+    if (parent_step->has_last_child_anchor && !anchor_is_vacuous) {
+      uint32_t node_depth = (uint32_t)state->start_depth + level;
+      if (node_depth == self->depth) {
+        if (has_later_named_siblings) return false;
+      } else if (node_depth < self->depth) {
+        if (ts_tree_cursor_ancestor_has_later_named_siblings(
+          &self->cursor,
+          self->depth - node_depth
+        )) return false;
+      } else {
+        // The state matched the parent node but none of its children.
+        TSNode node = ts_tree_cursor_current_node(&self->cursor);
+        if (ts_node_named_child_count(node) > 0) return false;
+      }
+    }
+    level--;
+  }
+  return true;
+}
