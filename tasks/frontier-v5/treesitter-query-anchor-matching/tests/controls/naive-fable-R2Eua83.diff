+// The constraint on the gap before the given step, as written in the pattern.
+// A pass-through step has no constraint of its own, and is transparent.
+static inline PendingGap ts_query__step_gap(const QueryStep *step) {
+  if (step->is_pass_through) return GapReset;
+  return step->is_immediate ? GapAnchored : GapFree;
+}
+
+static inline PendingGap ts_query__join_gaps(PendingGap a, PendingGap b) {
+  return a < b ? a : b;
+}
+
+// Update a state that has just moved to its current step in sequence: after
+// matching the previous step, after a dead-end jump, or after passing through
+// a repetition's pass-through step. The gap before the new step is whatever the
+// pattern says it is, because nothing has been skipped since the last match.
+static inline void ts_query_cursor__arrive_at_step(
+  TSQueryCursor *self,
+  QueryState *state
+) {
+  QueryStep *step = array_get(&self->query->steps, state->step_index);
+  state->pending_gap = ts_query__step_gap(step);
+}
+
+// Follow any dead-end jumps from the state's current step. A "dead-end" step
+// exists only to add a non-sequential jump into the step sequence.
+static inline void ts_query_cursor__resolve_dead_ends(
+  TSQueryCursor *self,
+  QueryState *state
+) {
+  for (;;) {
+    QueryStep *step = array_get(&self->query->steps, state->step_index);
+    if (!step->is_dead_end || step->alternative_index == NONE) return;
+    state->step_index = step->alternative_index;
+  }
+}
+
+// Release the state's capture list and mark it as dead, so that it is removed
+// from the list of in-progress states.
+static inline void ts_query_cursor__kill_state(
+  TSQueryCursor *self,
+  QueryState *state
+) {
+  capture_list_pool_release(&self->capture_list_pool, state->capture_list_id);
+  state->capture_list_id = CAPTURE_LIST_NONE;
+  state->dead = true;
+}
+
+// A state is leaving the child list at the given depth without having matched
+// anything since the previous match, and the gap between that previous match
+// and the end of the list is anchored. Determine whether the previously
+// matched sibling in that list is the last named child of its parent. That
+// sibling is the current node, an ancestor of the current node, or (if nothing
+// was matched in the list yet) nothing at all, in which case the parent must
+// have no named children.
+static bool ts_query_cursor__previous_sibling_is_last_child(
+  TSQueryCursor *self,
+  const QueryState *state,
+  uint32_t depth,
+  bool current_node_has_later_named_siblings
+) {
+  uint32_t current_level = self->depth - state->start_depth;
+  if (current_level == depth) {
+    return !current_node_has_later_named_siblings;
+  } else if (current_level > depth) {
+    return !ts_tree_cursor_ancestor_has_later_named_siblings(
+      &self->cursor,
+      current_level - depth
+    );
+  } else {
+    TSNode node = ts_tree_cursor_current_node(&self->cursor);
+    return ts_node_named_child_count(node) == 0;
+  }
+}
+
+// Update a state that skips over the optional (or repeated) step `step`,
+// matching nothing, and moves to the step after it, which is already stored in
+// `state->step_index`. Returns false if the state cannot skip the step because
+// doing so leaves a child list that ends with an anchor, and the previously
+// matched sibling in that list is not the last named child of its parent.
+static bool ts_query_cursor__skip_step(
+  TSQueryCursor *self,
+  QueryState *state,
+  const QueryStep *step,
+  bool current_node_has_later_named_siblings
+) {
+  ts_query_cursor__resolve_dead_ends(self, state);
+  QueryStep *target = array_get(&self->query->steps, state->step_index);
+  uint32_t depth = step->depth;
+
+  // Skipping to a later sibling step: the skipped step is transparent, so the
+  // gap before it and the gap after it are joined, and the weaker one wins.
+  if (target->depth != PATTERN_DONE_MARKER && target->depth >= depth) {
+    state->pending_gap = ts_query__join_gaps(state->pending_gap, ts_query__step_gap(target));
+    return true;
+  }
+
+  // Skipping out of the child list. If the list ends with an anchor, and the
+  // gap from the previously matched sibling up to here is anchored, then that
+  // sibling must be the last named child of its parent.
+  if (
+    step->list_has_trailing_anchor &&
+    state->pending_gap != GapFree &&
+    !ts_query_cursor__previous_sibling_is_last_child(
+      self,
+      state,
+      depth,
+      current_node_has_later_named_siblings
+    )
+  ) {
+    return false;
+  }
+
+  // The state is now in the enclosing child list, right after the parent of
+  // the list it left, so nothing has been skipped there.
+  state->pending_gap = ts_query__step_gap(target);
+  return true;
+}
