+bool ts_tree_cursor_ancestor_has_later_named_siblings(
+  const TSTreeCursor *_self,
+  unsigned levels_up
+) {
+  const TreeCursor *self = (const TreeCursor *)_self;
+  if (self->stack.size == 0) return false;
+
+  // Find the stack entry of the visible ancestor that is `levels_up` visible
+  // levels above the current node. Level zero is the current node itself.
+  uint32_t index = self->stack.size - 1;
+  while (levels_up > 0) {
+    if (index == 0) return false;
+    do {
+      index--;
+    } while (index > 0 && !ts_tree_cursor_is_entry_visible(self, index));
+    levels_up--;
+  }
+  if (index == 0) return false;
+
+  bool has_later_siblings, has_later_named_siblings;
+  ts_tree_cursor__entry_later_siblings(
+    self,
+    index,
+    &has_later_siblings,
+    &has_later_named_siblings
+  );
+  return has_later_named_siblings;
+}
