+module Tree = Base.Map.Using_comparator.Tree
+
+type ('key, 'value, 'cmp) t = {
+  points : ('key, 'value option, 'cmp) Tree.t;
+  comparator : ('key, 'cmp) Base.Comparator.t;
+  equal : 'value -> 'value -> bool;
+}
+
+let empty ~comparator ~equal =
