+    let left = if same t before value then left else Tree.set left ~comparator:t.comparator ~key:lower ~data:value in
+    let left = if same t value after then left else Tree.set left ~comparator:t.comparator ~key:upper ~data:after in
+    match Tree.append ~comparator:t.comparator ~lower_part:left ~upper_part:right with
+    | `Ok points -> Ok { t with points }
