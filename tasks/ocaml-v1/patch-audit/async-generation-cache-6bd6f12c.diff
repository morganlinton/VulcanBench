diff --git a/lib/alarm.ml b/lib/alarm.ml
index c0f537e..77edae0 100644
--- a/lib/alarm.ml
+++ b/lib/alarm.ml
@@ -1,6 +1,36 @@
-type t = unit
-type handle = unit
-let create _source = ()
-let at _ _ _ = ()
-let cancel _ = ()
-let pending _ = 0
+open Core
+open Async_kernel
+
+type t = { source : Time_source.t; mutable pending : int }
+type handle = {
+  owner : t;
+  mutable active : bool;
+  mutable event : Time_source.Event.t_unit option;
+}
+
+let create source = { source; pending = 0 }
+
+let deactivate handle =
+  if handle.active then (
+    handle.active <- false;
+    handle.owner.pending <- handle.owner.pending - 1)
+
+let at owner time callback =
+  let handle = { owner; active = true; event = None } in
+  owner.pending <- owner.pending + 1;
+  let event = Time_source.Event.run_at owner.source time (fun () ->
+    if handle.active then (
+      deactivate handle;
+      handle.event <- None;
+      callback ())) () in
+  handle.event <- Some event;
+  handle
+
+let cancel handle =
+  if handle.active then (
+    deactivate handle;
+    Option.iter handle.event ~f:(fun event ->
+      Time_source.Event.abort_if_possible event ());
+    handle.event <- None)
+
+let pending t = t.pending
diff --git a/lib/cache.ml b/lib/cache.ml
index 5e79b5a..d7d72ee 100644
--- a/lib/cache.ml
+++ b/lib/cache.ml
@@ -1,10 +1,152 @@
-type 'a t = { mutable closed:bool }
-let create ~source:_ ~policy:_ ~worker:_ = {closed=false}
-let get t _ = let request=Request.create () in
-  Request.resolve request (if t.closed then Request.Closed else Request.Failed "not implemented");
+open Core
+open Async_kernel
+
+type 'a generation = {
+  id : int;
+  key : string;
+  deadline : Time_ns.t;
+  mutable live : bool;
+  mutable requests : 'a Request.t list;
+  mutable attempts : int;
+  mutable deadline_alarm : Alarm.handle option;
+  mutable retry_alarm : Alarm.handle option;
+}
+
+type 'a t = {
+  source : Time_source.t;
+  policy : Policy.t;
+  worker : string -> attempt:int -> ('a, string) result Deferred.t;
+  alarms : Alarm.t;
+  current : 'a generation String.Table.t;
+  generations : 'a generation Int.Table.t;
+  values : ('a * Time_ns.t) String.Table.t;
+  mutable next_id : int;
+  mutable closed : bool;
+}
+
+let create ~source ~policy ~worker = {
+  source; policy; worker; alarms = Alarm.create source;
+  current = String.Table.create (); generations = Int.Table.create ();
+  values = String.Table.create (); next_id = 0; closed = false;
+}
+
+let is_current t generation =
+  match Hashtbl.find t.current generation.key with
+  | Some current -> phys_equal current generation
+  | None -> false
+
+(* Retire before resolving subscribers so every reentrant operation sees the
+   completed state. Detached generations can only remove their own identity. *)
+let retire t generation =
+  generation.live <- false;
+  if is_current t generation then Hashtbl.remove t.current generation.key;
+  Hashtbl.remove t.generations generation.id;
+  Option.iter generation.deadline_alarm ~f:Alarm.cancel;
+  Option.iter generation.retry_alarm ~f:Alarm.cancel;
+  generation.deadline_alarm <- None;
+  generation.retry_alarm <- None
+
+let finish t generation outcome =
+  if generation.live then (
+    retire t generation;
+    let requests = generation.requests in
+    generation.requests <- [];
+    List.iter requests ~f:(fun request -> Request.resolve request outcome))
+
+let eligible t generation =
+  if not generation.live then false
+  else if Time_ns.(Time_source.now t.source >= generation.deadline) then (
+    finish t generation Request.Timed_out;
+    false)
+  else true
+
+let rec start_attempt t generation =
+  if eligible t generation then (
+    generation.attempts <- generation.attempts + 1;
+    (* [run:`Now] calls the worker inside get, but delivers both normal results
+       and exceptions asynchronously. Each monitor consumes its late errors. *)
+    let result = Monitor.try_with ~run:`Now ~rest:(`Call (fun _ -> ()))
+      (fun () -> t.worker generation.key ~attempt:generation.attempts) in
+    upon result (fun result ->
+      if eligible t generation then (
+        let result = match result with
+          | Ok result -> result
+          | Error _ -> Error "worker exception"
+        in
+        match result with
+        | Ok value ->
+          if is_current t generation then
+            Hashtbl.set t.values ~key:generation.key
+              ~data:(value, Time_ns.add (Time_source.now t.source) t.policy.ttl);
+          finish t generation (Request.Value value)
+        | Error error ->
+          if generation.attempts >= t.policy.max_attempts then
+            finish t generation (Request.Failed error)
+          else (
+            let retry_at = Time_ns.add (Time_source.now t.source) t.policy.retry_delay in
+            (* The deadline alarm alone suffices if no retry can start in time. *)
+            if Time_ns.(retry_at < generation.deadline) then
+              generation.retry_alarm <- Some (Alarm.at t.alarms retry_at (fun () ->
+                generation.retry_alarm <- None;
+                start_attempt t generation))))))
+
+let subscribe t generation request =
+  generation.requests <- request :: generation.requests;
+  Request.on_cancel request (fun () ->
+    if generation.live then (
+      generation.requests <- List.filter generation.requests ~f:Request.is_pending;
+      if List.is_empty generation.requests then retire t generation))
+
+let fresh_value t key =
+  match Hashtbl.find t.values key with
+  | Some (value, expiration) when Time_ns.(Time_source.now t.source < expiration) ->
+    Some value
+  | Some _ -> Hashtbl.remove t.values key; None
+  | None -> None
+
+let get t key =
+  let request = Request.create () in
+  (if t.closed then Request.resolve request Request.Closed
+   else match fresh_value t key with
+     | Some value -> Request.resolve request (Request.Value value)
+     | None ->
+       match Hashtbl.find t.current key with
+       | Some generation when eligible t generation -> subscribe t generation request
+       | _ ->
+         let generation = {
+           id = t.next_id; key;
+           deadline = Time_ns.add (Time_source.now t.source) t.policy.timeout;
+           live = true; requests = []; attempts = 0;
+           deadline_alarm = None; retry_alarm = None;
+         } in
+         t.next_id <- t.next_id + 1;
+         Hashtbl.set t.current ~key ~data:generation;
+         Hashtbl.set t.generations ~key:generation.id ~data:generation;
+         subscribe t generation request;
+         generation.deadline_alarm <- Some (Alarm.at t.alarms generation.deadline
+           (fun () ->
+             generation.deadline_alarm <- None;
+             ignore (eligible t generation : bool)));
+         start_attempt t generation);
   request
-let invalidate _ _ = ()
-let close t = t.closed<-true
-let in_flight _ = 0
-let cached _ = 0
-let pending_alarms _ = 0
+
+let invalidate t key =
+  if not t.closed then (
+    Hashtbl.remove t.values key;
+    Hashtbl.remove t.current key)
+
+let close t =
+  if not t.closed then (
+    t.closed <- true;
+    Hashtbl.clear t.values;
+    List.iter (Hashtbl.data t.generations) ~f:(fun generation ->
+      finish t generation Request.Closed))
+
+let in_flight t = Hashtbl.length t.generations
+
+let cached t =
+  let time = Time_source.now t.source in
+  Hashtbl.filter_inplace t.values ~f:(fun (_, expiration) -> Time_ns.(time < expiration));
+  Hashtbl.length t.values
+
+let pending_alarms t = Alarm.pending t.alarms
diff --git a/public/dune b/public/dune
index 9154e84..6cbd704 100644
--- a/public/dune
+++ b/public/dune
@@ -1 +1,2 @@
 (test (name smoke) (libraries cache_engine core async_kernel))
+(test (name regression) (libraries cache_engine core async_kernel))
diff --git a/public/regression.ml b/public/regression.ml
new file mode 100644
index 0000000..9077aaa
--- /dev/null
+++ b/public/regression.ml
@@ -0,0 +1,253 @@
+open Core
+open Core.Poly
+open Async_kernel
+
+let drain () = Async_kernel_scheduler.Expert.run_cycles_until_no_jobs_remain ()
+let span n = Time_ns.Span.of_int_sec n
+let time n = Time_ns.add Time_ns.epoch (span n)
+let make_source () = Time_source.create ~now:Time_ns.epoch ()
+let advance source n =
+  Time_source.advance_directly source ~to_:(time n);
+  Time_source.fire_past_alarms source
+let policy ?(ttl = 10) ?(timeout = 10) ?(delay = 2) ?(attempts = 3) () =
+  Policy.create ~ttl:(span ttl) ~timeout:(span timeout)
+    ~retry_delay:(span delay) ~max_attempts:attempts
+let outcome request = Deferred.peek (Request.result request)
+let assert_clean cache source =
+  assert (Cache.in_flight cache = 0);
+  assert (Cache.pending_alarms cache = 0);
+  assert (Time_source.next_alarm_fires_at source = None)
+
+let generations () =
+  let source = make_source () in
+  let calls = ref [] in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun key ~attempt ->
+      let result = Ivar.create () in
+      calls := !calls @ [key, attempt, result];
+      Ivar.read result) in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "x" in
+  assert (List.length !calls = 1);
+  assert (outcome a = None);
+  Request.cancel a;
+  Cache.invalidate cache "x";
+  let c = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let d = Cache.get cache "x" in
+  assert (Cache.in_flight cache = 3);
+  let results = List.map !calls ~f:(fun (_, _, result) -> result) in
+  Ivar.fill_exn (List.nth_exn results 2) (Ok 30);
+  drain ();
+  assert (outcome d = Some (Request.Value 30));
+  Ivar.fill_exn (List.nth_exn results 0) (Ok 10);
+  Ivar.fill_exn (List.nth_exn results 1) (Ok 20);
+  drain ();
+  assert (outcome a = Some Request.Cancelled);
+  assert (outcome b = Some (Request.Value 10));
+  assert (outcome c = Some (Request.Value 20));
+  assert (outcome (Cache.get cache "x") = Some (Request.Value 30));
+  assert (Cache.cached cache = 1);
+  assert_clean cache source;
+  advance source 10;
+  assert (Cache.cached cache = 0);
+  let e = Cache.get cache "x" in
+  Request.cancel e;
+  Request.cancel e;
+  assert_clean cache source;
+  Ivar.fill_exn (let _, _, result = List.last_exn !calls in result) (Ok 40);
+  drain ();
+  assert (Cache.cached cache = 0)
+
+let retries () =
+  let source = make_source () in
+  let attempts = ref [] in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt -> attempts := attempt :: !attempts; return (Error (Int.to_string attempt))) in
+  let a = Cache.get cache "x" in
+  assert (!attempts = [1]);
+  drain ();
+  assert (Cache.pending_alarms cache = 2);
+  advance source 2;
+  drain ();
+  assert (!attempts = [2; 1]);
+  let b = Cache.get cache "x" in
+  advance source 4;
+  drain ();
+  assert (!attempts = [3; 2; 1]);
+  assert (outcome a = Some (Request.Failed "3"));
+  assert (outcome b = outcome a);
+  assert_clean cache source;
+  let source = make_source () in
+  let count = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source)
+    ~policy:(policy ~timeout:2 ())
+    ~worker:(fun _ ~attempt:_ -> incr count; return (Error "retry")) in
+  let request = Cache.get cache "x" in
+  drain ();
+  assert (Cache.pending_alarms cache = 1);
+  advance source 2;
+  drain ();
+  assert (!count = 1);
+  assert (outcome request = Some Request.Timed_out);
+  assert_clean cache source
+
+let deadline_and_close () =
+  let source = make_source () in
+  let results = ref [] in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt:_ ->
+      let result = Ivar.create () in
+      results := result :: !results;
+      Ivar.read result) in
+  let a = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let b = Cache.get cache "x" in
+  (* Neither the scheduler nor the deadline alarm has processed this boundary. *)
+  Time_source.advance_directly source ~to_:(time 10);
+  Ivar.fill_exn (List.last_exn !results) (Ok 1);
+  drain ();
+  assert (outcome a = Some Request.Timed_out);
+  Time_source.fire_past_alarms source;
+  drain ();
+  assert (outcome b = Some Request.Timed_out);
+  assert (Cache.cached cache = 0);
+  assert_clean cache source;
+  let c = Cache.get cache "y" in
+  Cache.invalidate cache "y";
+  let d = Cache.get cache "y" in
+  Cache.close cache;
+  Cache.close cache;
+  Cache.invalidate cache "y";
+  assert (outcome c = Some Request.Closed);
+  assert (outcome d = Some Request.Closed);
+  assert (outcome (Cache.get cache "z") = Some Request.Closed);
+  List.iter !results ~f:(fun result -> Ivar.fill_if_empty result (Ok 2));
+  drain ();
+  assert_clean cache source;
+  assert (Cache.cached cache = 0)
+
+let exceptions () =
+  let source = make_source () in
+  let old_monitor = ref None in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt ->
+      match attempt with
+      | 1 -> failwith "synchronous"
+      | 2 ->
+        old_monitor := Some (Monitor.current ());
+        Async_kernel_scheduler.schedule (fun () -> failwith "asynchronous");
+        Deferred.never ()
+      | _ -> return (Ok 9)) in
+  let request = Cache.get cache "x" in
+  drain ();
+  advance source 2;
+  drain ();
+  advance source 4;
+  drain ();
+  assert (outcome request = Some (Request.Value 9));
+  Monitor.send_exn (Option.value_exn !old_monitor) (Failure "late");
+  drain ();
+  assert (Cache.cached cache = 1);
+  assert_clean cache source
+
+let reentry () =
+  let source = make_source () in
+  let cache_ref = ref None in
+  let joined = ref None in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ~ttl:0 ())
+    ~worker:(fun key ~attempt:_ ->
+      incr calls;
+      joined := Some (Cache.get (Option.value_exn !cache_ref) key);
+      return (Ok 5)) in
+  cache_ref := Some cache;
+  let request = Cache.get cache "x" in
+  assert (!calls = 1);
+  assert (outcome request = None);
+  drain ();
+  assert (outcome request = Some (Request.Value 5));
+  assert (outcome (Option.value_exn !joined) = outcome request);
+  assert (Cache.cached cache = 0);
+  assert_clean cache source;
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun key ~attempt:_ ->
+      let cache = Option.value_exn !cache_ref in
+      let joined = Cache.get cache key in
+      Request.cancel joined;
+      Cache.invalidate cache key;
+      Cache.close cache;
+      return (Ok 7)) in
+  cache_ref := Some cache;
+  let request = Cache.get cache "x" in
+  assert (outcome request = Some Request.Closed);
+  drain ();
+  assert_clean cache source
+
+let alarms () =
+  let source = make_source () in
+  let alarms = Alarm.create (Time_source.read_only source) in
+  let fired = ref false in
+  let handle = Alarm.at alarms (time 1) (fun () -> fired := true) in
+  advance source 1;
+  Alarm.cancel handle;
+  Alarm.cancel handle;
+  drain ();
+  assert (not !fired);
+  assert (Alarm.pending alarms = 0);
+  ignore (Alarm.at alarms (time 1) (fun () ->
+    assert (Alarm.pending alarms = 0);
+    fired := true) : Alarm.handle);
+  drain ();
+  assert (!fired)
+
+let detached_retry_and_cancellation () =
+  let source = make_source () in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt ->
+      incr calls;
+      if !calls = 1 then return (Error "detached error")
+      else if attempt = 1 then return (Ok 20)
+      else return (Ok 10)) in
+  let old = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let current = Cache.get cache "x" in
+  drain ();
+  assert (outcome current = Some (Request.Value 20));
+  assert (Cache.in_flight cache = 1);
+  advance source 2;
+  drain ();
+  assert (outcome old = Some (Request.Value 10));
+  assert (outcome (Cache.get cache "x") = Some (Request.Value 20));
+  assert_clean cache source;
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt:_ -> return (Error "cancel during retry wait")) in
+  let request = Cache.get cache "x" in
+  drain ();
+  assert (Cache.pending_alarms cache = 2);
+  Request.cancel request;
+  assert_clean cache source
+
+let overdue_retry () =
+  let source = make_source () in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt:_ -> incr calls; return (Error "error")) in
+  let request = Cache.get cache "x" in
+  drain ();
+  advance source 10;
+  drain ();
+  assert (!calls = 1);
+  assert (outcome request = Some Request.Timed_out);
+  assert_clean cache source
+
+let () =
+  generations ();
+  retries ();
+  deadline_and_close ();
+  exceptions ();
+  reentry ();
+  alarms ();
+  detached_retry_and_cancellation ();
+  overdue_retry ()
