-(test (name smoke) (libraries cache_engine core async_kernel))
+(tests (names smoke generations) (libraries cache_engine core async_kernel))
diff --git a/public/generations.ml b/public/generations.ml
new file mode 100644
index 0000000..c7813ac
--- /dev/null
+++ b/public/generations.ml
@@ -0,0 +1,294 @@
+open Core
+open Core.Poly
+open Async_kernel
+module Scheduler = Async_kernel_scheduler.Private
+
+let drain () = Scheduler.run_cycles_until_no_jobs_remain ()
+let time seconds = Time_ns.add Time_ns.epoch (Time_ns.Span.of_int_sec seconds)
+let advance source seconds =
+  Time_source.advance_directly source ~to_:(time seconds);
+  Time_source.fire_past_alarms source;
+  drain ()
+let outcome request = Deferred.peek (Request.result request)
+let policy ?(ttl=5) ?(timeout=10) ?(retry=2) ?(attempts=3) () =
+  Policy.create ~ttl:(Time_ns.Span.of_int_sec ttl)
+    ~timeout:(Time_ns.Span.of_int_sec timeout)
+    ~retry_delay:(Time_ns.Span.of_int_sec retry) ~max_attempts:attempts
+let controlled ?(policy=policy ()) () =
+  let source = Time_source.create ~now:Time_ns.epoch () in
+  let calls = ref [] in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy
+    ~worker:(fun key ~attempt ->
+      let result = Ivar.create () in
+      calls := !calls @ [key, attempt, result];
+      Ivar.read result) in
+  source, cache, calls
+let complete calls index result =
+  let _, _, ivar = List.nth_exn !calls index in
+  Ivar.fill_exn ivar result;
+  drain ()
+let empty source cache =
+  assert (Cache.in_flight cache = 0);
+  assert (Cache.pending_alarms cache = 0);
+  assert (Time_source.next_alarm_fires_at source = None)
+
+let generations () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "x" in
+  assert (List.length !calls = 1);
+  assert (outcome a = None);
+  Cache.invalidate cache "x";
+  let c = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let d = Cache.get cache "x" in
+  let other = Cache.get cache "y" in
+  assert (Cache.in_flight cache = 4);
+  complete calls 2 (Ok 30);
+  assert (outcome d = Some (Request.Value 30));
+  complete calls 1 (Ok 20);
+  assert (outcome c = Some (Request.Value 20));
+  complete calls 0 (Ok 10);
+  assert (outcome a = Some (Request.Value 10));
+  assert (outcome b = Some (Request.Value 10));
+  assert (outcome (Cache.get cache "x") = Some (Request.Value 30));
+  assert (List.length !calls = 4);
+  complete calls 3 (Ok 40);
+  assert (outcome other = Some (Request.Value 40));
+  empty source cache;
+  assert (Cache.cached cache = 2);
+  advance source 5;
+  assert (Cache.cached cache = 0);
+  let stale = Cache.get cache "x" in
+  assert (List.length !calls = 5);
+  Cache.close cache;
+  assert (outcome stale = Some Request.Closed);
+  empty source cache
+
+let cancellation () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "x" in
+  Request.cancel a;
+  Request.cancel a;
+  assert (outcome a = Some Request.Cancelled);
+  assert (Cache.in_flight cache = 1);
+  complete calls 0 (Error "retry");
+  assert (Cache.pending_alarms cache = 2);
+  Request.cancel b;
+  empty source cache;
+  let c = Cache.get cache "x" in
+  assert (List.length !calls = 2);
+  Request.cancel c;
+  complete calls 1 (Ok 7);
+  assert (Cache.cached cache = 0);
+  advance source 20;
+  assert (List.length !calls = 2);
+  empty source cache
+
+let detached_retries () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let b = Cache.get cache "x" in
+  complete calls 0 (Error "old");
+  advance source 2;
+  assert (List.map !calls ~f:(fun (_, attempt, _) -> attempt) = [1; 1; 2]);
+  complete calls 2 (Ok 1);
+  assert (outcome a = Some (Request.Value 1));
+  assert (outcome b = None);
+  assert (Cache.cached cache = 0);
+  assert (Cache.in_flight cache = 1);
+  Cache.close cache;
+  complete calls 1 (Ok 2);
+  assert (outcome b = Some Request.Closed);
+  empty source cache
+
+let deadlines () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  advance source 9;
+  let b = Cache.get cache "x" in
+  complete calls 0 (Error "too late to retry");
+  assert (Cache.pending_alarms cache = 1);
+  advance source 10;
+  assert (outcome a = Some Request.Timed_out);
+  assert (outcome b = Some Request.Timed_out);
+  assert (List.length !calls = 1);
+  empty source cache;
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  let _, _, result = List.hd_exn !calls in
+  Ivar.fill_exn result (Ok 42);
+  (* No alarm callback has run when the result is made available at the deadline. *)
+  Time_source.advance_directly source ~to_:(time 10);
+  let b = Cache.get cache "x" in
+  assert (outcome a = Some Request.Timed_out);
+  assert (List.length !calls = 2);
+  drain ();
+  assert (Cache.cached cache = 0);
+  assert (outcome b = None);
+  Cache.close cache;
+  empty source cache
+
+let cancellation_at_deadline () =
+  let source, cache, _ = controlled () in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "x" in
+  Time_source.advance_directly source ~to_:(time 10);
+  Request.cancel a;
+  assert (outcome a = Some Request.Cancelled);
+  assert (outcome b = Some Request.Timed_out);
+  empty source cache;
+  drain ()
+
+let processing_time () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  let _, _, result = List.hd_exn !calls in
+  Ivar.fill_exn result (Ok 8);
+  Time_source.advance_directly source ~to_:(time 3);
+  assert (outcome a = None);
+  drain ();
+  advance source 7;
+  assert (outcome (Cache.get cache "x") = Some (Request.Value 8));
+  assert (List.length !calls = 1);
+  advance source 8;
+  assert (Cache.cached cache = 0);
+  ignore (Cache.get cache "x");
+  assert (List.length !calls = 2);
+  Cache.close cache;
+  empty source cache
+
+let close_retries () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let b = Cache.get cache "x" in
+  complete calls 0 (Error "old");
+  complete calls 1 (Error "new");
+  assert (Cache.in_flight cache = 2);
+  assert (Cache.pending_alarms cache = 4);
+  Cache.close cache;
+  assert (outcome a = Some Request.Closed);
+  assert (outcome b = Some Request.Closed);
+  empty source cache;
+  advance source 20;
+  assert (List.length !calls = 2)
+
+let retries () =
+  let source, cache, calls = controlled () in
+  let a = Cache.get cache "x" in
+  advance source 1;
+  complete calls 0 (Error "one");
+  advance source 2;
+  assert (List.length !calls = 1);
+  advance source 3;
+  assert (List.length !calls = 2);
+  complete calls 1 (Error "two");
+  advance source 5;
+  complete calls 2 (Error "last");
+  assert (outcome a = Some (Request.Failed "last"));
+  empty source cache;
+  let source, cache, calls = controlled ~policy:(policy ~ttl:0 ()) () in
+  let a = Cache.get cache "x" in
+  complete calls 0 (Ok 1);
+  Request.cancel a;
+  assert (outcome a = Some (Request.Value 1));
+  assert (Cache.cached cache = 0);
+  ignore (Cache.get cache "x");
+  assert (List.length !calls = 2);
+  Cache.close cache;
+  empty source cache
+
+let exceptions () =
+  let source = Time_source.create ~now:Time_ns.epoch () in
+  let monitors = ref [] in
+  let second_result = Ivar.create () in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt ->
+      monitors := !monitors @ [Monitor.current ()];
+      if attempt = 1 then failwith "synchronous"
+      else if attempt = 2 then Ivar.read second_result
+      else return (Ok 99)) in
+  let a = Cache.get cache "x" in
+  assert (List.length !monitors = 1);
+  drain ();
+  advance source 2;
+  assert (List.length !monitors = 2);
+  Monitor.send_exn (List.nth_exn !monitors 0) (Failure "late old error");
+  drain ();
+  assert (Cache.pending_alarms cache = 1);
+  Monitor.send_exn (List.nth_exn !monitors 1) (Failure "asynchronous");
+  drain ();
+  assert (Cache.pending_alarms cache = 2);
+  Ivar.fill_exn second_result (Ok 55);
+  drain ();
+  assert (outcome a = None);
+  assert (Cache.cached cache = 0);
+  advance source 4;
+  assert (outcome a = Some (Request.Value 99));
+  List.iter !monitors ~f:(fun monitor -> Monitor.send_exn monitor (Failure "late"));
+  drain ();
+  assert (outcome a = Some (Request.Value 99));
+  empty source cache;
+  let failed = Cache.create ~source:(Time_source.read_only source)
+    ~policy:(policy ~attempts:1 ()) ~worker:(fun _ ~attempt:_ -> failwith "boom") in
+  let request = Cache.get failed "x" in
+  drain ();
+  assert (outcome request = Some (Request.Failed "worker exception"));
+  empty source failed
+
+let reentry () =
+  let source = Time_source.create ~now:Time_ns.epoch () in
+  let reference = ref None in
+  let joined = ref None in
+  let replacement = ref None in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun key ~attempt:_ ->
+      incr calls;
+      let cache = Option.value_exn !reference in
+      assert (Cache.in_flight cache = !calls);
+      if !calls = 1 then begin
+        joined := Some (Cache.get cache key);
+        Request.cancel (Option.value_exn !joined);
+        Cache.invalidate cache key;
+        replacement := Some (Cache.get cache key)
+      end else Cache.close cache;
+      return (Ok !calls)) in
+  reference := Some cache;
+  let a = Cache.get cache "x" in
+  assert (!calls = 2);
+  assert (outcome a = Some Request.Closed);
+  assert (outcome (Option.value_exn !joined) = Some Request.Cancelled);
+  assert (outcome (Option.value_exn !replacement) = Some Request.Closed);
+  Cache.close cache;
+  Cache.invalidate cache "x";
+  assert (outcome (Cache.get cache "x") = Some Request.Closed);
+  drain ();
+  assert (Cache.cached cache = 0);
+  empty source cache
+
+let alarms () =
+  let source = Time_source.create ~now:Time_ns.epoch () in
+  let alarms = Alarm.create (Time_source.read_only source) in
+  let called = ref false in
+  let cancelled = Alarm.at alarms (time 1) (fun () -> called := true) in
+  let fired = Alarm.at alarms (time 1) (fun () -> assert (Alarm.pending alarms = 0)) in
+  Time_source.advance_directly source ~to_:(time 1);
+  Time_source.fire_past_alarms source;
+  Alarm.cancel cancelled;
+  Alarm.cancel cancelled;
+  assert (Alarm.pending alarms = 1);
+  drain ();
+  assert (not !called);
+  Alarm.cancel fired;
+  assert (Alarm.pending alarms = 0);
+  assert (Time_source.next_alarm_fires_at source = None)
+
+let () =
+  List.iter [generations; cancellation; detached_retries; deadlines; retries;
+             cancellation_at_deadline; processing_time; close_retries;
+             exceptions; reentry; alarms] ~f:(fun test -> test ());
+  assert (Scheduler.uncaught_exn (Scheduler.t ()) = None)
