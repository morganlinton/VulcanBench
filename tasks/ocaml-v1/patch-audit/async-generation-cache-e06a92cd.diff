diff --git a/public/regression.ml b/public/regression.ml
new file mode 100644
index 0000000..f9a4e00
--- /dev/null
+++ b/public/regression.ml
@@ -0,0 +1,247 @@
+open Core
+open Core.Poly
+open Async_kernel
+
+let drain () = Async_kernel_scheduler.Expert.run_cycles_until_no_jobs_remain ()
+let span = Time_ns.Span.of_int_sec
+let time seconds = Time_ns.add Time_ns.epoch (span seconds)
+let make_source () = Time_source.create ~now:Time_ns.epoch ()
+let advance source seconds =
+  Time_source.advance_directly source ~to_:(time seconds);
+  Time_source.fire_past_alarms source
+let policy ?(ttl=5) ?(timeout=10) ?(retry=2) ?(attempts=3) () =
+  Policy.create ~ttl:(span ttl) ~timeout:(span timeout)
+    ~retry_delay:(span retry) ~max_attempts:attempts
+let expect request outcome = assert (Deferred.peek (Request.result request) = Some outcome)
+let clean cache source =
+  assert (Cache.in_flight cache = 0);
+  assert (Cache.pending_alarms cache = 0);
+  assert (Time_source.next_alarm_fires_at source = None)
+let controlled source policy =
+  let calls = ref [] in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy
+    ~worker:(fun key ~attempt ->
+      let result = Ivar.create () in
+      calls := !calls @ [key, attempt, result];
+      Ivar.read result) in
+  cache, calls
+let complete calls index result =
+  let _, _, ivar = List.nth_exn !calls index in
+  Ivar.fill_exn ivar result;
+  drain ()
+
+let () =
+  (* Detached generations remain independent, including multiple invalidations. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "x" in
+  assert (List.length !calls = 1);
+  Request.cancel a; Request.cancel a;
+  expect a Request.Cancelled;
+  Cache.invalidate cache "x";
+  let c = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let d = Cache.get cache "x" in
+  assert (Cache.in_flight cache = 3);
+  complete calls 2 (Ok 30);
+  complete calls 0 (Ok 10);
+  complete calls 1 (Ok 20);
+  expect b (Request.Value 10);
+  expect c (Request.Value 20);
+  expect d (Request.Value 30);
+  expect (Cache.get cache "x") (Request.Value 30);
+  clean cache source;
+  advance source 5;
+  assert (Cache.cached cache = 0);
+  let e = Cache.get cache "x" in
+  assert (List.length !calls = 4);
+  Request.cancel e;
+  clean cache source;
+  complete calls 3 (Ok 40);
+  assert (Cache.cached cache = 0);
+
+  (* Retry delays are measured from error processing; subscribers share attempts. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  advance source 1;
+  complete calls 0 (Error "first");
+  assert (Cache.pending_alarms cache = 2);
+  let b = Cache.get cache "x" in
+  advance source 2; drain ();
+  assert (List.length !calls = 1);
+  advance source 3; drain ();
+  complete calls 1 (Error "second");
+  advance source 5; drain ();
+  let _, attempt, _ = List.nth_exn !calls 2 in
+  assert (attempt = 3);
+  complete calls 2 (Error "last");
+  expect a (Request.Failed "last"); expect b (Request.Failed "last");
+  clean cache source;
+
+  (* A due deadline wins before its alarm callback is delivered. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  advance source 10;
+  complete calls 0 (Ok 1);
+  expect a Request.Timed_out;
+  clean cache source;
+  assert (Cache.cached cache = 0);
+  let b = Cache.get cache "x" in
+  advance source 20; drain ();
+  expect b Request.Timed_out;
+  clean cache source;
+
+  (* A retry exactly at the deadline is never started. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ~timeout:2 ()) in
+  let a = Cache.get cache "x" in
+  complete calls 0 (Error "retry");
+  assert (Cache.pending_alarms cache = 1);
+  advance source 2; drain ();
+  expect a Request.Timed_out;
+  assert (List.length !calls = 1);
+  clean cache source;
+
+  (* Cancelling the final subscriber aborts both retry and deadline. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  complete calls 0 (Error "retry");
+  Request.cancel a;
+  clean cache source;
+  let b = Cache.get cache "x" in
+  assert (List.length !calls = 2);
+  Cache.invalidate cache "x";
+  let c = Cache.get cache "y" in
+  Cache.close cache; Cache.close cache;
+  expect b Request.Closed; expect c Request.Closed;
+  clean cache source;
+  complete calls 1 (Ok 1); complete calls 2 (Error "late");
+  expect (Cache.get cache "x") Request.Closed;
+  assert (List.length !calls = 3);
+
+  (* Worker exceptions retry, and old attempt monitors swallow late errors. *)
+  let source = make_source () in
+  let monitors = ref [] in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun _ ~attempt ->
+      incr calls;
+      monitors := Monitor.current () :: !monitors;
+      match attempt with
+      | 1 -> failwith "synchronous"
+      | 2 ->
+        Async_kernel_scheduler.schedule (fun () -> failwith "asynchronous");
+        Deferred.never ()
+      | _ -> return (Ok 9)) in
+  let a = Cache.get cache "x" in
+  assert (!calls = 1);
+  drain ();
+  advance source 2; drain ();
+  Monitor.send_exn (List.last_exn !monitors) (Failure "late first attempt");
+  drain ();
+  advance source 4; drain ();
+  expect a (Request.Value 9);
+  List.iter !monitors ~f:(fun monitor -> Monitor.send_exn monitor (Failure "late"));
+  drain ();
+  clean cache source;
+
+  (* Worker reentrancy sees fully registered requests, generations and timers. *)
+  let source = make_source () in
+  let cache_ref = ref None in
+  let joined = ref None in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun key ~attempt:_ ->
+      let cache = Option.value_exn !cache_ref in
+      joined := Some (Cache.get cache key);
+      assert (Cache.in_flight cache = 1);
+      assert (Cache.pending_alarms cache = 1);
+      Cache.invalidate cache key;
+      Cache.close cache;
+      return (Ok 1)) in
+  cache_ref := Some cache;
+  let a = Cache.get cache "x" in
+  expect a Request.Closed;
+  expect (Option.value_exn !joined) Request.Closed;
+  drain (); clean cache source;
+
+  (* A detached retry cannot remove or populate its replacement. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  Cache.invalidate cache "x";
+  let b = Cache.get cache "x" in
+  complete calls 0 (Error "detached retry");
+  complete calls 1 (Ok 2);
+  advance source 2; drain ();
+  complete calls 2 (Ok 1);
+  expect a (Request.Value 1); expect b (Request.Value 2);
+  expect (Cache.get cache "x") (Request.Value 2);
+  clean cache source;
+
+  (* A joining subscriber cannot extend an already due deadline. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ()) in
+  let a = Cache.get cache "x" in
+  Time_source.advance_directly source ~to_:(time 10);
+  let b = Cache.get cache "x" in
+  expect a Request.Timed_out; expect b Request.Timed_out;
+  clean cache source;
+  complete calls 0 (Ok 1);
+  assert (Cache.cached cache = 0);
+
+  (* Zero TTL never reuses a value; unrelated keys start independently. *)
+  let source = make_source () in
+  let cache, calls = controlled source (policy ~ttl:0 ()) in
+  let a = Cache.get cache "x" in
+  let b = Cache.get cache "y" in
+  assert (Cache.in_flight cache = 2);
+  complete calls 0 (Ok 1); complete calls 1 (Ok 2);
+  expect a (Request.Value 1); expect b (Request.Value 2);
+  assert (Cache.cached cache = 0);
+  let c = Cache.get cache "x" in
+  assert (List.length !calls = 3);
+  Request.cancel c; clean cache source;
+
+  (* Invalidation and replacement inside a worker keep both generations alive. *)
+  let source = make_source () in
+  let cache_ref = ref None in
+  let replacement = ref None in
+  let calls = ref 0 in
+  let cache = Cache.create ~source:(Time_source.read_only source) ~policy:(policy ())
+    ~worker:(fun key ~attempt:_ ->
+      incr calls;
+      if !calls = 1 then begin
+        let cache = Option.value_exn !cache_ref in
+        Cache.invalidate cache key;
+        replacement := Some (Cache.get cache key);
+        assert (Cache.in_flight cache = 2);
+        return (Ok 1)
+      end else return (Ok 2)) in
+  cache_ref := Some cache;
+  let original = Cache.get cache "x" in
+  assert (Request.is_pending original);
+  drain ();
+  expect original (Request.Value 1);
+  expect (Option.value_exn !replacement) (Request.Value 2);
+  expect (Cache.get cache "x") (Request.Value 2);
+  clean cache source;
+
+  (* Alarm cancellation also works after enqueueing; counts change before callbacks. *)
+  let source = make_source () in
+  let alarms = Alarm.create (Time_source.read_only source) in
+  let cancelled = Alarm.at alarms (time 1) (fun () -> assert false) in
+  advance source 1;
+  Alarm.cancel cancelled; Alarm.cancel cancelled;
+  drain ();
+  assert (Alarm.pending alarms = 0);
+  let fired = ref false in
+  let handle = Alarm.at alarms (time 1) (fun () ->
+    assert (Alarm.pending alarms = 0); fired := true) in
+  drain ();
+  assert !fired;
+  Alarm.cancel handle;
+  assert (Alarm.pending alarms = 0)
