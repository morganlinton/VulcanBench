diff --git a/lib/alarm.ml b/lib/alarm.ml
index c0f537e..d83bbbb 100644
--- a/lib/alarm.ml
+++ b/lib/alarm.ml
@@ -1,6 +1,33 @@
-type t = unit
-type handle = unit
-let create _source = ()
-let at _ _ _ = ()
-let cancel _ = ()
-let pending _ = 0
+open Async_kernel
+
+type t = { source : Time_source.t; mutable pending : int }
+type handle = {
+  owner : t;
+  mutable active : bool;
+  mutable event : Time_source.Event.t_unit option;
+}
+
+let create source = { source; pending = 0 }
+
+let at owner time callback =
+  let handle = { owner; active = true; event = None } in
+  owner.pending <- owner.pending + 1;
+  let event = Time_source.Event.run_at owner.source time (fun () ->
+    if handle.active then begin
+      handle.active <- false;
+      owner.pending <- owner.pending - 1;
+      handle.event <- None;
+      callback ()
+    end) () in
+  handle.event <- Some event;
+  handle
+
+let cancel handle =
+  if handle.active then begin
+    handle.active <- false;
+    handle.owner.pending <- handle.owner.pending - 1;
+    Option.iter (fun event -> Time_source.Event.abort_if_possible event ()) handle.event;
+    handle.event <- None
+  end
+
+let pending t = t.pending
diff --git a/lib/cache.ml b/lib/cache.ml
index 5e79b5a..251359a 100644
--- a/lib/cache.ml
+++ b/lib/cache.ml
@@ -1,10 +1,161 @@
-type 'a t = { mutable closed:bool }
-let create ~source:_ ~policy:_ ~worker:_ = {closed=false}
-let get t _ = let request=Request.create () in
-  Request.resolve request (if t.closed then Request.Closed else Request.Failed "not implemented");
+open Core
+open Async_kernel
+
+type 'a generation = {
+  id : int;
+  key : string;
+  deadline : Time_ns.t;
+  mutable live : bool;
+  mutable requests : 'a Request.t list;
+  mutable attempt : int;
+  mutable deadline_alarm : Alarm.handle option;
+  mutable retry_alarm : Alarm.handle option;
+}
+
+type 'a t = {
+  source : Time_source.t;
+  policy : Policy.t;
+  worker : string -> attempt:int -> ('a, string) result Deferred.t;
+  alarms : Alarm.t;
+  current : (string, 'a generation) Hashtbl.t;
+  generations : (int, 'a generation) Hashtbl.t;
+  values : (string, 'a * Time_ns.t) Hashtbl.t;
+  mutable next_id : int;
+  mutable closed : bool;
+}
+
+let create ~source ~policy ~worker = {
+  source; policy; worker; alarms = Alarm.create source;
+  current = Hashtbl.create (module String);
+  generations = Hashtbl.create (module Int);
+  values = Hashtbl.create (module String);
+  next_id = 0; closed = false;
+}
+
+let is_current t generation =
+  match Hashtbl.find t.current generation.key with
+  | Some current -> phys_equal current generation
+  | None -> false
+
+let retire t generation =
+  generation.live <- false;
+  Option.iter generation.deadline_alarm ~f:Alarm.cancel;
+  Option.iter generation.retry_alarm ~f:Alarm.cancel;
+  generation.deadline_alarm <- None;
+  generation.retry_alarm <- None;
+  Hashtbl.remove t.generations generation.id;
+  if is_current t generation then Hashtbl.remove t.current generation.key
+
+let finish t generation outcome =
+  if generation.live then begin
+    retire t generation;
+    let requests = generation.requests in
+    generation.requests <- [];
+    List.iter requests ~f:(fun request ->
+      Request.on_cancel request (fun () -> ());
+      Request.resolve request outcome)
+  end
+
+let eligible t generation =
+  if not generation.live then false
+  else if Time_ns.(Time_source.now t.source >= generation.deadline) then begin
+    finish t generation Request.Timed_out;
+    false
+  end else true
+
+let rec start_attempt t generation =
+  if eligible t generation then begin
+    generation.attempt <- generation.attempt + 1;
+    let attempt = generation.attempt in
+    (* The worker runs inside get; results and exceptions are processed by Async.
+       Each attempt's monitor ignores errors after that attempt finishes. *)
+    let result = Monitor.try_with ~run:`Now ~rest:(`Call (fun _ -> ()))
+      (fun () -> t.worker generation.key ~attempt) in
+    upon result (fun result ->
+      if eligible t generation then
+        match result with
+        | Ok (Ok value) ->
+          if is_current t generation then
+            Hashtbl.set t.values ~key:generation.key
+              ~data:(value, Time_ns.add (Time_source.now t.source) t.policy.ttl);
+          finish t generation (Request.Value value)
+        | Ok (Error error) -> failed_attempt t generation error
+        | Error _ -> failed_attempt t generation "worker exception")
+  end
+
+and failed_attempt t generation error =
+  if generation.attempt >= t.policy.max_attempts then
+    finish t generation (Request.Failed error)
+  else begin
+    let retry_at = Time_ns.add (Time_source.now t.source) t.policy.retry_delay in
+    (* Only the deadline alarm is needed if the retry cannot run in time. *)
+    if Time_ns.(retry_at < generation.deadline) then
+      generation.retry_alarm <- Some (Alarm.at t.alarms retry_at (fun () ->
+        generation.retry_alarm <- None;
+        start_attempt t generation))
+  end
+
+let subscribe t generation request =
+  generation.requests <- request :: generation.requests;
+  Request.on_cancel request (fun () ->
+    if generation.live then begin
+      generation.requests <- List.filter generation.requests ~f:Request.is_pending;
+      if List.is_empty generation.requests then retire t generation
+    end)
+
+let get t key =
+  let request = Request.create () in
+  if t.closed then Request.resolve request Request.Closed
+  else begin
+    let current_time = Time_source.now t.source in
+    let value = match Hashtbl.find t.values key with
+      | Some (value, expiration) when Time_ns.(current_time < expiration) -> Some value
+      | Some _ -> Hashtbl.remove t.values key; None
+      | None -> None in
+    match value with
+    | Some value -> Request.resolve request (Request.Value value)
+    | None ->
+      match Hashtbl.find t.current key with
+      | Some generation ->
+        subscribe t generation request;
+        ignore (eligible t generation : bool)
+      | None ->
+        let generation = {
+          id = t.next_id; key; deadline = Time_ns.add current_time t.policy.timeout;
+          live = true; requests = []; attempt = 0;
+          deadline_alarm = None; retry_alarm = None;
+        } in
+        t.next_id <- t.next_id + 1;
+        Hashtbl.set t.current ~key ~data:generation;
+        Hashtbl.set t.generations ~key:generation.id ~data:generation;
+        subscribe t generation request;
+        generation.deadline_alarm <- Some (Alarm.at t.alarms generation.deadline
+          (fun () ->
+            generation.deadline_alarm <- None;
+            finish t generation Request.Timed_out));
+        start_attempt t generation
+  end;
   request
-let invalidate _ _ = ()
-let close t = t.closed<-true
-let in_flight _ = 0
-let cached _ = 0
-let pending_alarms _ = 0
+
+let invalidate t key =
+  if not t.closed then begin
+    Hashtbl.remove t.values key;
+    Hashtbl.remove t.current key
+  end
+
+let close t =
+  if not t.closed then begin
+    t.closed <- true;
+    Hashtbl.clear t.values;
+    List.iter (Hashtbl.data t.generations) ~f:(fun generation ->
+      finish t generation Request.Closed)
+  end
+
+let in_flight t = Hashtbl.length t.generations
+
+let cached t =
+  let current_time = Time_source.now t.source in
+  Hashtbl.filter_inplace t.values ~f:(fun (_, expiration) -> Time_ns.(current_time < expiration));
+  Hashtbl.length t.values
+
+let pending_alarms t = Alarm.pending t.alarms
