diff --git a/public/graph_tests.ml b/public/graph_tests.ml
new file mode 100644
index 0000000..ef49f7b
--- /dev/null
+++ b/public/graph_tests.ml
@@ -0,0 +1,126 @@
+open Expression
+
+let ok = function Ok () -> () | Error message -> failwith message
+let edit t sources formulas = ok (Graph.transaction t ~sources ~formulas)
+let observe t name = Option.get (Graph.subscribe t name)
+let expect_error t sources formulas message =
+  assert (Graph.transaction t ~sources ~formulas = Error message)
+
+let () =
+  (try ignore (Graph.create ["x", 1; "x", 2]); assert false
+   with Invalid_argument _ -> ());
+  let t = Graph.create ["flag", 0; "a", 2; "b", 9] in
+  edit t [] ["result", Add (Ref "selected", Const 1);
+             "selected", Select ("flag", Ref "a", Ref "b");
+             "unused", Add (Ref "a", Ref "b")];
+  let result = observe t "result" in
+  Graph.stabilize t;
+  assert (Graph.value result = 3);
+  assert (Graph.additions t = 1);
+  Graph.stabilize t;
+  assert (Graph.additions t = 1);
+  edit t ["b", 20] [];
+  assert (Graph.value result = 3);
+  Graph.stabilize t;
+  assert (Graph.value result = 3 && Graph.additions t = 1);
+  edit t ["flag", 1] [];
+  Graph.stabilize t;
+  assert (Graph.value result = 21 && Graph.additions t = 2);
+  edit t ["flag", 2] [];
+  Graph.stabilize t;
+  assert (Graph.additions t = 2);
+  edit t ["flag", 2] ["result", Add (Ref "selected", Const 1)];
+  Graph.stabilize t;
+  assert (Graph.additions t = 2);
+  edit t [] ["selected", Const 20];
+  assert (Graph.value result = 21);
+  Graph.stabilize t;
+  assert (Graph.value result = 21 && Graph.additions t = 2);
+  edit t [] ["selected", Const 30];
+  Graph.stabilize t;
+  assert (Graph.value result = 31 && Graph.additions t = 3);
+  expect_error t ["a", 3; "a", 4] ["bad", Ref "bad"] "duplicate edit";
+  expect_error t [] ["bad", Const 0; "bad", Ref "absent"] "duplicate edit";
+  expect_error t ["absent", 0] [] "unknown reference";
+  expect_error t [] ["a", Const 0] "unknown reference";
+  expect_error t ["a", 100] ["bad", Select ("flag", Const 0, Ref "absent");
+                             "cyclic", Ref "cyclic"] "unknown reference";
+  expect_error t ["a", 100] ["bad", Select ("flag", Const 0, Ref "bad")] "cycle";
+  assert (Graph.subscribe t "bad" = None);
+  let a = observe t "a" in
+  Graph.stabilize t;
+  assert (Graph.value a = 2 && Graph.additions t = 3)
+
+let () =
+  let t = Graph.create ["flag", 0; "x", 1] in
+  edit t [] ["chosen", Select ("flag", Add (Ref "x", Const 1),
+                              Add (Ref "x", Const 10))];
+  let chosen = observe t "chosen" in
+  Graph.stabilize t;
+  assert (Graph.value chosen = 2 && Graph.additions t = 1);
+  edit t ["flag", 1] [];
+  Graph.stabilize t;
+  assert (Graph.value chosen = 11 && Graph.additions t = 2);
+  edit t ["flag", 2] [];
+  Graph.stabilize t;
+  assert (Graph.additions t = 2)
+
+let () =
+  let t = Graph.create [] in
+  edit t [] ["x", Ref "y"; "y", Const 1];
+  let x = observe t "x" and y = observe t "y" in
+  Graph.stabilize t;
+  edit t [] ["y", Ref "x"; "x", Const 2];
+  Graph.stabilize t;
+  assert (Graph.value x = 2 && Graph.value y = 2);
+  edit t [] ["x", Ref "y"; "y", Const 3];
+  Graph.stabilize t;
+  assert (Graph.value x = 3 && Graph.value y = 3)
+
+let () =
+  let a = Graph.create ["x", 1] and b = Graph.create ["x", 2] in
+  let sa = observe a "x" and sb = observe b "x" in
+  Graph.stabilize a;
+  Graph.stabilize b;
+  edit a ["x", 10] [];
+  edit b ["x", 20] [];
+  Graph.stabilize a;
+  assert (Graph.value sa = 10 && Graph.value sb = 2)
+
+let () =
+  let t = Graph.create ["a", 2; "b", 3; "flag", 0] in
+  edit t [] ["sum", Add (Ref "a", Ref "b");
+             "result", Add (Ref "sum", Const 1);
+             "inactive", Add (Ref "a", Const 10);
+             "selected", Select ("flag", Ref "result", Ref "inactive")];
+  let selected = observe t "selected" in
+  Graph.stabilize t;
+  assert (Graph.value selected = 6 && Graph.additions t = 2);
+  edit t ["a", 3; "b", 2] [];
+  Graph.stabilize t;
+  assert (Graph.value selected = 6 && Graph.additions t = 3);
+  edit t [] ["inactive", Add (Ref "b", Const 20)];
+  Graph.stabilize t;
+  assert (Graph.additions t = 3);
+  expect_error t ["a", 100] ["sum", Ref "selected"] "cycle";
+  Graph.stabilize t;
+  assert (Graph.additions t = 3);
+  edit t ["flag", 1] [];
+  Graph.stabilize t;
+  assert (Graph.value selected = 22 && Graph.additions t = 4);
+  edit t [] ["selected", Const 42];
+  assert (Graph.value selected = 22);
+  Graph.stabilize t;
+  assert (Graph.value selected = 42 && Graph.additions t = 4)
+
+let () =
+  let t = Graph.create ["source", 7] in
+  let formulas = List.init 200 (fun i ->
+    string_of_int i, Ref (if i = 0 then "source" else string_of_int (i - 1))) in
+  edit t [] formulas;
+  let result = observe t "199" in
+  Graph.stabilize t;
+  assert (Graph.value result = 7);
+  edit t ["source", 9] [];
+  Graph.stabilize t;
+  assert (Graph.value result = 9)
