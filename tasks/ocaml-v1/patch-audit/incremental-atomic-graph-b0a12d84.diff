diff --git a/lib/graph.ml b/lib/graph.ml
index 9125ecf..d463906 100644
--- a/lib/graph.ml
+++ b/lib/graph.ml
@@ -1,8 +1,151 @@
-type t = { sources : (string,int ref) Hashtbl.t }
-type subscription = int ref
-let create values = let sources=Hashtbl.create 8 in List.iter(fun (n,v)->if Hashtbl.mem sources n then invalid_arg "duplicate source"; Hashtbl.add sources n (ref v)) values; {sources}
-let transaction _ ~sources:_ ~formulas:_ = Error "unknown reference"
-let subscribe t n = Hashtbl.find_opt t.sources n
-let stabilize _ = ()
-let value s = !s
-let additions _ = 0
+module Incr = Incremental
+
+type 'w compiled = {
+  expression : Expression.t;
+  result : (int, 'w) Incr.t;
+  children : 'w compiled list;
+}
+
+type 'w node = {
+  input : ((int, 'w) Incr.t, 'w) Incr.Var.t;
+  output : (int, 'w) Incr.t;
+  mutable compiled : 'w compiled option;
+}
+
+type 'w graph = {
+  state : 'w Incr.State.t;
+  sources : (string, (int, 'w) Incr.Var.t) Hashtbl.t;
+  formulas : (string, Expression.t) Hashtbl.t;
+  nodes : (string, 'w node) Hashtbl.t;
+  additions : int ref;
+}
+
+type t = Graph : 'w graph -> t
+type subscription = Subscription : (int, 'w) Incr.Observer.t -> subscription
+
+let node state input =
+  let input = Incr.Var.create state input in
+  let output = Incr.bind (Incr.Var.watch input) ~f:(fun value -> value) in
+  Incr.set_cutoff output Incr.Cutoff.poly_equal;
+  { input; output; compiled = None }
+
+let create values =
+  let module State = (val Incr.State.create ()) in
+  let state = State.t in
+  let sources = Hashtbl.create 8 in
+  let nodes = Hashtbl.create 8 in
+  List.iter
+    (fun (name, value) ->
+      if Hashtbl.mem sources name then invalid_arg "duplicate source";
+      let source = Incr.Var.create state value in
+      Hashtbl.add sources name source;
+      Hashtbl.add nodes name (node state (Incr.Var.watch source)))
+    values;
+  Graph { state; sources; nodes; formulas = Hashtbl.create 8; additions = ref 0 }
+
+let duplicate edits =
+  let seen = Hashtbl.create 8 in
+  List.exists
+    (fun (name, _) ->
+      if Hashtbl.mem seen name then true
+      else (Hashtbl.add seen name (); false))
+    edits
+
+let rec compile t previous expression =
+  match previous with
+  | Some compiled when compiled.expression = expression -> compiled
+  | _ ->
+    let left, right =
+      match previous with
+      | Some { children = [a; b]; _ } -> Some a, Some b
+      | _ -> None, None
+    in
+    let result, children =
+      match expression with
+      | Expression.Const value -> Incr.const t.state value, []
+      | Expression.Ref name -> (Hashtbl.find t.nodes name).output, []
+      | Expression.Add (a, b) ->
+        let a = compile t left a in
+        let b = compile t right b in
+        let result = Incr.map2 a.result b.result ~f:(fun a b -> incr t.additions; a + b) in
+        result, [a; b]
+      | Expression.Select (name, a, b) ->
+        let a = compile t left a in
+        let b = compile t right b in
+        let flag = (Hashtbl.find t.nodes name).output in
+        (* Only changes between zero and nonzero change the dependency. *)
+        let zero = Incr.map flag ~f:(fun value -> value = 0) in
+        Incr.set_cutoff zero Incr.Cutoff.poly_equal;
+        let result = Incr.bind zero ~f:(fun zero -> if zero then a.result else b.result) in
+        result, [a; b]
+    in
+    Incr.set_cutoff result Incr.Cutoff.poly_equal;
+    { expression; result; children }
+
+let transaction (Graph t) ~sources ~formulas =
+  if duplicate sources || duplicate formulas then Error "duplicate edit"
+  else
+    let prospective = Hashtbl.copy t.formulas in
+    List.iter (fun (name, expression) -> Hashtbl.replace prospective name expression) formulas;
+    let known name = Hashtbl.mem t.sources name || Hashtbl.mem prospective name in
+    let unknown =
+      List.exists (fun (name, _) -> not (Hashtbl.mem t.sources name)) sources
+      || List.exists (fun (name, _) -> Hashtbl.mem t.sources name) formulas
+      || Hashtbl.fold
+           (fun _ expression unknown ->
+             unknown || List.exists (fun name -> not (known name)) (Expression.references expression))
+           prospective false
+    in
+    if unknown then Error "unknown reference"
+    else
+      let visiting = Hashtbl.create 8 in
+      let visited = Hashtbl.create 8 in
+      let rec cyclic name =
+        if Hashtbl.mem visiting name then true
+        else if Hashtbl.mem visited name then false
+        else
+          match Hashtbl.find_opt prospective name with
+          | None -> false
+          | Some expression ->
+            Hashtbl.add visiting name ();
+            let cycle = List.exists cyclic (Expression.references expression) in
+            Hashtbl.remove visiting name;
+            Hashtbl.add visited name ();
+            cycle
+      in
+      if Hashtbl.fold (fun name _ cycle -> cycle || cyclic name) prospective false then
+        Error "cycle"
+      else (
+        (* Allocate every name before compiling, permitting forward references. *)
+        List.iter
+          (fun (name, _) ->
+            if not (Hashtbl.mem t.nodes name) then
+              Hashtbl.add t.nodes name (node t.state (Incr.const t.state 0)))
+          formulas;
+        List.iter
+          (fun (name, expression) ->
+            if Hashtbl.find_opt t.formulas name <> Some expression then (
+              let node = Hashtbl.find t.nodes name in
+              let compiled = compile t node.compiled expression in
+              Incr.Var.set node.input compiled.result;
+              node.compiled <- Some compiled;
+              Hashtbl.replace t.formulas name expression))
+          formulas;
+        List.iter
+          (fun (name, value) ->
+            let source = Hashtbl.find t.sources name in
+            if Incr.Var.latest_value source <> value then Incr.Var.set source value)
+          sources;
+        Ok ())
+
+let subscribe (Graph t) name =
+  Option.map (fun node -> Subscription (Incr.observe node.output)) (Hashtbl.find_opt t.nodes name)
+
+let stabilize (Graph t) =
+  (* A valid graph can exceed Incremental's default height limit of 128. *)
+  let limit = Incr.State.num_nodes_created t.state + 128 in
+  if limit > Incr.State.max_height_allowed t.state then
+    Incr.State.set_max_height_allowed t.state limit;
+  Incr.stabilize t.state
+let value (Subscription observer) = Incr.Observer.value_exn observer
+let additions (Graph t) = !(t.additions)
