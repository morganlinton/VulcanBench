@@ -0,0 +1,108 @@
+let ok = function Ok () -> () | Error error -> failwith error
+let observe t name = Option.get (Graph.subscribe t name)
+let check t s expected = Graph.stabilize t; assert (Graph.value s = expected)
+let () =
+  let open Expression in
+  (try ignore (Graph.create ["x", 1; "x", 2]); assert false with Invalid_argument _ -> ());
+  let t = Graph.create ["flag", 0; "a", 2; "b", 9] in
+  ok (Graph.transaction t ~sources:[] ~formulas:[
+    "result", Add (Ref "selected", Const 1);
+    "selected", Select ("flag", Ref "a", Ref "b");
+    "unused", Add (Ref "a", Ref "b")]);
+  let s = observe t "result" in
+  check t s 3;
+  assert (Graph.additions t = 1);
+  ok (Graph.transaction t ~sources:["b", 12] ~formulas:[]);
+  assert (Graph.value s = 3);
+  check t s 3;
+  assert (Graph.additions t = 1);
+  ok (Graph.transaction t ~sources:["flag", 1] ~formulas:[]);
+  check t s 13;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:["flag", 2] ~formulas:[]);
+  check t s 13;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:["b", 12] ~formulas:["result", Add (Ref "selected", Const 1)]);
+  check t s 13;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:[] ~formulas:["selected", Const 12]);
+  assert (Graph.value s = 13);
+  check t s 13;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:[] ~formulas:["selected", Const 20]);
+  check t s 21;
+  assert (Graph.additions t = 3);
+  Graph.stabilize t;
+  assert (Graph.additions t = 3);
+  let expect_error error sources formulas =
+    assert (Graph.transaction t ~sources ~formulas = Error error);
+    check t s 21;
+    assert (Graph.additions t = 3)
+  in
+  expect_error "duplicate edit" ["missing", 1; "missing", 2] ["loop", Ref "loop"];
+  expect_error "duplicate edit" [] ["loop", Ref "loop"; "loop", Const 1];
+  expect_error "unknown reference" ["missing", 1] ["loop", Ref "loop"];
+  expect_error "unknown reference" [] ["a", Const 1];
+  expect_error "unknown reference" ["a", 99] ["selected", Select ("flag", Const 1, Ref "missing")];
+  expect_error "cycle" ["a", 99] ["selected", Select ("flag", Const 1, Ref "result")];
+  let t = Graph.create [] in
+  ok (Graph.transaction t ~sources:[] ~formulas:["a", Ref "b"; "b", Const 1]);
+  let a = observe t "a" in
+  let b = observe t "b" in
+  check t a 1;
+  ok (Graph.transaction t ~sources:[] ~formulas:["b", Ref "a"; "a", Const 2]);
+  check t a 2;
+  assert (Graph.value b = 2);
+  ok (Graph.transaction t ~sources:[] ~formulas:["a", Ref "b"; "b", Const 3]);
+  check t b 3;
+  assert (Graph.value a = 3)
+
+let () =
+  let open Expression in
+  let t = Graph.create ["flag", 0; "a", 2; "b", 9] in
+  ok (Graph.transaction t ~sources:[] ~formulas:[
+    "chosen", Select ("flag", Add (Ref "a", Const 1), Add (Ref "b", Const 1));
+    "out", Add (Ref "chosen", Const 1)]);
+  let s = observe t "out" in
+  check t s 4;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:["b", 20] ~formulas:[]);
+  check t s 4;
+  assert (Graph.additions t = 2);
+  ok (Graph.transaction t ~sources:["flag", 1] ~formulas:[]);
+  check t s 22;
+  assert (Graph.additions t = 4);
+  ok (Graph.transaction t ~sources:[] ~formulas:["chosen", Add (Const 10, Const 11)]);
+  check t s 22;
+  assert (Graph.additions t = 5);
+  let other = Graph.create ["x", 1] in
+  ok (Graph.transaction other ~sources:[] ~formulas:["y", Add (Ref "x", Const 1)]);
+  let y = observe other "y" in
+  Graph.stabilize t;
+  assert (Graph.additions other = 0);
+  check other y 2;
+  ok (Graph.transaction other ~sources:["x", 7] ~formulas:[]);
+  Graph.stabilize t;
+  assert (Graph.value y = 2);
+  check other y 8
+
+let () =
+  let open Expression in
+  let t = Graph.create ["x", 0] in
+  let formulas = List.init 150 (fun i ->
+    string_of_int i, Add (Ref (if i = 0 then "x" else string_of_int (i - 1)), Const 1)) in
+  ok (Graph.transaction t ~sources:[] ~formulas);
+  check t (observe t "149") 150
+
+let () =
+  let open Expression in
+  let t = Graph.create ["flag", 0; "a", 2] in
+  ok (Graph.transaction t ~sources:[] ~formulas:[
+    "out", Select ("flag", Add (Ref "a", Const 1), Const 9)]);
+  let s = observe t "out" in
+  check t s 3;
+  assert (Graph.additions t = 1);
+  ok (Graph.transaction t ~sources:[] ~formulas:[
+    "out", Select ("flag", Add (Ref "a", Const 1), Const 10)]);
+  check t s 3;
+  assert (Graph.additions t = 1)
