diff --git a/lib/interval_map.ml b/lib/interval_map.ml
index 2ce05b8..03fee17 100644
--- a/lib/interval_map.ml
+++ b/lib/interval_map.ml
@@ -1,10 +1,50 @@
-type ('k, 'v, 'cmp) t = { comparator : ('k, 'cmp) Base.Comparator.t; equal : 'v -> 'v -> bool; points : ('k * 'v option) list }
-let empty ~comparator ~equal = { comparator; equal; points = [] }
-let boundaries t = t.points
+module Tree = Base.Map.Using_comparator.Tree
+
+type ('k, 'v, 'cmp) t = {
+  comparator : ('k, 'cmp) Base.Comparator.t;
+  equal : 'v -> 'v -> bool;
+  points : ('k, 'v option, 'cmp) Tree.t;
+}
+
+let empty ~comparator ~equal =
+  { comparator; equal; points = Tree.empty ~comparator }
+
+let boundaries t = Tree.to_alist t.points
+
 let find t key =
-  List.fold_left (fun current (k,v) -> if t.comparator.compare k key <= 0 then v else current) None t.points
+  match Tree.closest_key ~comparator:t.comparator t.points `Less_or_equal_to key with
+  | None -> None
+  | Some (_, value) -> value
+
+let equal_value t a b =
+  match a, b with
+  | None, None -> true
+  | Some a, Some b -> t.equal a b
+  | None, Some _ | Some _, None -> false
+
 let assign t ~lower ~upper ~value =
-  let _equal = t.equal in
-  if t.comparator.compare lower upper > 0 then Error "reversed interval"
-  else if t.comparator.compare lower upper = 0 then Ok t
-  else Ok { t with points = [lower, value; upper, None] }
+  let comparator = t.comparator in
+  let order = comparator.compare lower upper in
+  if order > 0 then Error "reversed interval"
+  else if order = 0 then Ok t
+  else
+    (* Discard the overwritten boundaries while sharing untouched subtrees. *)
+    let upper_value = find t upper in
+    let left, _, rest = Tree.split ~comparator t.points lower in
+    let _, _, right = Tree.split ~comparator rest upper in
+    let lower_value =
+      match Tree.max_elt left with
+      | None -> None
+      | Some (_, value) -> value
+    in
+    let left =
+      if equal_value t lower_value value then left
+      else Tree.set ~comparator left ~key:lower ~data:value
+    in
+    let right =
+      if equal_value t value upper_value then right
+      else Tree.set ~comparator right ~key:upper ~data:upper_value
+    in
+    match Tree.append ~comparator ~lower_part:left ~upper_part:right with
+    | `Ok points -> Ok { t with points }
+    | `Overlapping_key_ranges -> assert false
