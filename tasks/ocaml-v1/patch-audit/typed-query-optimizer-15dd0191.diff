diff --git a/lib/optimizer.ml b/lib/optimizer.ml
index 37698bc..0fcc000 100644
--- a/lib/optimizer.ml
+++ b/lib/optimizer.ml
@@ -1,5 +1,151 @@
 type ('src, 'dst) renaming = { apply : 'a. ('src, 'a) Expr.var -> ('dst, 'a) Expr.var }
 type ('src, 'dst) substitution = { replace : 'a. ('src, 'a) Expr.var -> ('dst, 'a) Expr.t }
-let rename _ _ = failwith "capture-avoiding rename is not implemented"
-let substitute _ _ = failwith "capture-avoiding substitution is not implemented"
-let normalize term = term
+
+open Expr
+
+let lift_renaming : type src dst bound.
+    (src, dst) renaming -> (bound * src, bound * dst) renaming =
+  fun mapping ->
+    let apply : type a. (bound * src, a) var -> (bound * dst, a) var = function
+      | Z -> Z
+      | S v -> S (mapping.apply v)
+    in
+    { apply }
+
+let rec rename : type src dst a.
+    (src, dst) renaming -> (src, a) t -> (dst, a) t =
+  fun mapping term ->
+    match term with
+    | Int n -> Int n
+    | Bool b -> Bool b
+    | Var v -> Var (mapping.apply v)
+    | Read key -> Read key
+    | Add (a, b) -> Add (rename mapping a, rename mapping b)
+    | Mul (a, b) -> Mul (rename mapping a, rename mapping b)
+    | Equal (a, b) -> Equal (rename mapping a, rename mapping b)
+    | If (p, a, b) -> If (rename mapping p, rename mapping a, rename mapping b)
+    | Pair (a, b) -> Pair (rename mapping a, rename mapping b)
+    | Fst x -> Fst (rename mapping x)
+    | Snd x -> Snd (rename mapping x)
+    | Let (value, body) ->
+        Let (rename mapping value, rename (lift_renaming mapping) body)
+
+let lift_substitution : type src dst bound.
+    (src, dst) substitution -> (bound * src, bound * dst) substitution =
+  fun mapping ->
+    let replace : type a. (bound * src, a) var -> (bound * dst, a) t = function
+      | Z -> Var Z
+      | S v -> rename { apply = fun v -> S v } (mapping.replace v)
+    in
+    { replace }
+
+let rec substitute : type src dst a.
+    (src, dst) substitution -> (src, a) t -> (dst, a) t =
+  fun mapping term ->
+    match term with
+    | Int n -> Int n
+    | Bool b -> Bool b
+    | Var v -> mapping.replace v
+    | Read key -> Read key
+    | Add (a, b) -> Add (substitute mapping a, substitute mapping b)
+    | Mul (a, b) -> Mul (substitute mapping a, substitute mapping b)
+    | Equal (a, b) -> Equal (substitute mapping a, substitute mapping b)
+    | If (p, a, b) ->
+        If (substitute mapping p, substitute mapping a, substitute mapping b)
+    | Pair (a, b) -> Pair (substitute mapping a, substitute mapping b)
+    | Fst x -> Fst (substitute mapping x)
+    | Snd x -> Snd (substitute mapping x)
+    | Let (value, body) ->
+        Let (substitute mapping value, substitute (lift_substitution mapping) body)
+
+let rec pure : type env a. (env, a) t -> bool = function
+  | Read _ -> false
+  | Int _ | Bool _ | Var _ -> true
+  | Add (a, b) | Mul (a, b) -> pure a && pure b
+  | Equal (a, b) -> pure a && pure b
+  | Pair (a, b) -> pure a && pure b
+  | If (p, a, b) -> pure p && pure a && pure b
+  | Fst x -> pure x
+  | Snd x -> pure x
+  | Let (value, body) -> pure value && pure body
+
+let rec literal : type env a. (env, a) t -> bool = function
+  | Int _ | Bool _ -> true
+  | Pair (a, b) -> literal a && literal b
+  | _ -> false
+
+let rec at_depth : type env a. int -> (env, a) var -> bool =
+  fun depth v ->
+    match v with Z -> depth = 0 | S v -> depth > 0 && at_depth (depth - 1) v
+
+(* A nested Let adds a slot only in its body, not in its value. *)
+let rec uses : type env a. int -> (env, a) t -> bool =
+  fun depth term ->
+    match term with
+    | Var v -> at_depth depth v
+    | Int _ | Bool _ | Read _ -> false
+    | Add (a, b) | Mul (a, b) -> uses depth a || uses depth b
+    | Equal (a, b) -> uses depth a || uses depth b
+    | Pair (a, b) -> uses depth a || uses depth b
+    | If (p, a, b) -> uses depth p || uses depth a || uses depth b
+    | Fst x -> uses depth x
+    | Snd x -> uses depth x
+    | Let (value, body) -> uses depth value || uses (depth + 1) body
+
+let bind : type env a. (env, a) t -> (a * env, env) substitution =
+  fun value ->
+    let replace : type b. (a * env, b) var -> (env, b) t = function
+      | Z -> value
+      | S v -> Var v
+    in
+    { replace }
+
+let rec normalize : type env a. (env, a) t -> (env, a) t = function
+  | Int n -> Int n
+  | Bool b -> Bool b
+  | Var v -> Var v
+  | Read key -> Read key
+  | Add (a, b) ->
+      let a = normalize a in
+      let b = normalize b in
+      (match a, b with
+       | Int x, Int y -> Int (x + y)
+       | Int 0, x | x, Int 0 -> x
+       | _ -> Add (a, b))
+  | Mul (a, b) ->
+      let a = normalize a in
+      let b = normalize b in
+      (match a, b with
+       | Int x, Int y -> Int (x * y)
+       | Int 1, x | x, Int 1 -> x
+       | Int 0, x | x, Int 0 when pure x -> Int 0
+       | _ -> Mul (a, b))
+  | Equal (a, b) ->
+      let a = normalize a in
+      let b = normalize b in
+      (match a, b with
+       | Int x, Int y -> Bool (x = y)
+       | _ -> Equal (a, b))
+  | If (p, a, b) ->
+      let p = normalize p in
+      let a = normalize a in
+      let b = normalize b in
+      (match p with Bool true -> a | Bool false -> b | _ -> If (p, a, b))
+  | Pair (a, b) ->
+      let a = normalize a in
+      let b = normalize b in
+      Pair (a, b)
+  | Fst x ->
+      let x = normalize x in
+      (match x with Pair (a, b) when pure b -> a | _ -> Fst x)
+  | Snd x ->
+      let x = normalize x in
+      (match x with Pair (a, b) when pure a -> b | _ -> Snd x)
+  | Let (value, body) ->
+      let value = normalize value in
+      let body = normalize body in
+      if literal value then normalize (substitute (bind value) body)
+      else if pure value && not (uses 0 body) then
+        (* Z is absent, so this only removes the slot from outer variables. *)
+        substitute (bind value) body
+      else Let (value, body)
