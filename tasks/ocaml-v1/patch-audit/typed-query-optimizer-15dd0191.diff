+++ b/public/normalization.ml
@@ -0,0 +1,129 @@
+open Expr
+
+let normal term expected =
+  let normalized = Optimizer.normalize term in
+  assert (Measure.fingerprint normalized = Measure.fingerprint expected);
+  assert (Measure.fingerprint (Optimizer.normalize normalized) =
+          Measure.fingerprint normalized)
+
+exception Read_failure of string
+
+let observe env term fail_at =
+  let trace = ref [] in
+  let read key =
+    trace := key :: !trace;
+    if Some key = fail_at then raise (Read_failure key);
+    String.length key
+  in
+  let result =
+    try Ok (Eval.run ~read env term) with Read_failure key -> Error key
+  in
+  result, List.rev !trace
+
+let equivalent env term =
+  let normalized = Optimizer.normalize term in
+  assert (Measure.fingerprint (Optimizer.normalize normalized) =
+          Measure.fingerprint normalized);
+  List.iter (fun fail_at ->
+    assert (observe env term fail_at = observe env normalized fail_at))
+    [None; Some "a"; Some "b"; Some "c"]
+
+let swap : (int * (bool * unit), bool * (int * unit)) Optimizer.renaming =
+  let apply : type a.
+      (int * (bool * unit), a) var -> (bool * (int * unit), a) var = function
+    | Z -> S Z
+    | S Z -> Z
+    | S (S _) -> .
+  in
+  { apply }
+
+let replacement : (int * unit, int * unit) Optimizer.substitution =
+  let replace : type a. (int * unit, a) var -> (int * unit, a) t = function
+    | Z -> Add (Var Z, Int 1)
+    | S _ -> .
+  in
+  { replace }
+
+let () =
+  let term = Let (Read "a", Pair (Var (S Z), Var (S (S Z)))) in
+  let renamed = Optimizer.rename swap term in
+  assert (Measure.fingerprint renamed =
+          Measure.fingerprint
+            (Let (Read "a", Pair (Var (S (S Z)), Var (S Z)))));
+  assert (observe (7, (true, ())) term None =
+          observe (true, (7, ())) renamed None);
+  let body = Let (Var Z, Let (Int 3, Add (Var (S (S Z)), Var (S Z)))) in
+  let substituted = Optimizer.substitute replacement body in
+  assert (Measure.fingerprint substituted =
+          Measure.fingerprint
+            (Let (Add (Var Z, Int 1),
+              Let (Int 3, Add (Add (Var (S (S Z)), Int 1), Var (S Z))))));
+  normal (Add (Int 0, Mul (Int 1, Int 4))) (Int 4);
+  normal (Mul (Var Z, Int 0)) (Int 0);
+  normal (Mul (Int 0, Read "a")) (Mul (Int 0, Read "a"));
+  normal (If (Equal (Int 2, Int 2), Int 5, Read "b")) (Int 5);
+  normal (Fst (Pair (Int 4, Read "a"))) (Fst (Pair (Int 4, Read "a")));
+  normal (Snd (Pair (Read "a", Bool true)))
+    (Snd (Pair (Read "a", Bool true)));
+  normal (Fst (Pair (Read "a", Bool true))) (Read "a");
+  normal (Snd (Pair (Int 4, Read "a"))) (Read "a");
+  normal (Let (Pair (Int 4, Pair (Bool true, Int 2)),
+               If (Fst (Snd (Var Z)), Add (Fst (Var Z), Snd (Snd (Var Z))), Int 0)))
+    (Int 6);
+  normal (Let (Int 4, Let (Read "a", Add (Var (S Z), Var Z))))
+    (Let (Read "a", Add (Int 4, Var Z)));
+  normal (Let (Read "a", Add (Var Z, Int 0))) (Let (Read "a", Var Z));
+  normal (Let (Read "a", Int 4)) (Let (Read "a", Int 4));
+  normal (Let (Add (Var Z, Int 1), Var Z))
+    (Let (Add (Var Z, Int 1), Var Z));
+  normal (Let (Add (Var Z, Int 1),
+               Let (Read "a", Add (Var Z, Var (S (S Z))))))
+    (Let (Read "a", Add (Var Z, Var (S Z))));
+  normal (Let (Add (Var Z, Int 1),
+               Let (Read "a", Add (Var (S Z), Var Z))))
+    (Let (Add (Var Z, Int 1), Let (Read "a", Add (Var (S Z), Var Z))));
+  normal (Let (Add (Var Z, Int 1), Let (Var Z, Int 9))) (Int 9);
+  equivalent () (Pair (Fst (Pair (Read "a", Read "b")), Read "c"));
+  equivalent () (Let (Read "a", If (Bool true, Mul (Int 0, Read "b"), Read "c")))
+
+(* Deterministic trees include open variables, nested binders, predicates,
+   mixed-type pairs, and effectful branches. *)
+let random = Random.State.make [| 2026; 10; 1 |]
+let choose n = Random.State.int random n
+
+let rec integer : type env. (env, int) var list -> int -> (env, int) t =
+  fun vars depth ->
+    if depth = 0 then
+      match choose 3, vars with
+      | 0, v :: _ -> Var v
+      | 1, _ -> Read (List.nth ["a"; "b"; "c"] (choose 3))
+      | _ -> Int (choose 5 - 2)
+    else
+      let child () = integer vars (depth - 1) in
+      match choose 9 with
+      | 0 -> Add (child (), child ())
+      | 1 -> Mul (child (), child ())
+      | 2 -> If (boolean vars (depth - 1), child (), child ())
+      | 3 -> Let (child (), integer (Z :: List.map (fun v -> S v) vars) (depth - 1))
+      | 4 -> Fst (Pair (child (), boolean vars (depth - 1)))
+      | 5 -> Snd (Pair (boolean vars (depth - 1), child ()))
+      | 6 -> Let (boolean vars (depth - 1),
+                  If (Var Z, integer (List.map (fun v -> S v) vars) (depth - 1),
+                      Int 0))
+      | _ -> integer vars 0
+and boolean : type env. (env, int) var list -> int -> (env, bool) t =
+  fun vars depth ->
+    if depth = 0 then Bool (choose 2 = 0)
+    else match choose 4 with
+      | 0 -> Equal (integer vars (depth - 1), integer vars (depth - 1))
+      | 1 -> If (boolean vars (depth - 1), boolean vars (depth - 1),
+                 boolean vars (depth - 1))
+      | 2 -> Let (integer vars (depth - 1),
+                  boolean (Z :: List.map (fun v -> S v) vars) (depth - 1))
+      | _ -> Bool (choose 2 = 0)
+
+let () =
+  for _ = 1 to 1000 do
+    equivalent (7, (-3, ())) (integer [Z; S Z] 5);
+    equivalent (7, (-3, ())) (boolean [Z; S Z] 5)
+  done
