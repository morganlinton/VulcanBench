index 0000000..6451f66
--- /dev/null
+++ b/public/optimizer_test.ml
@@ -0,0 +1,136 @@
+open Expr
+
+exception Read_failure of string
+
+let check env term =
+  let normalized = Optimizer.normalize term in
+  assert (Measure.fingerprint normalized =
+          Measure.fingerprint (Optimizer.normalize normalized));
+  let observe fail term =
+    let trace = ref [] in
+    let read key =
+      trace := key :: !trace;
+      if Some key = fail then raise (Read_failure key);
+      match key with "a" -> 3 | "b" -> 0 | _ -> -2
+    in
+    let result =
+      try Ok (Eval.run ~read env term)
+      with Read_failure key -> Error key
+    in
+    result, List.rev !trace
+  in
+  List.iter (fun fail -> assert (observe fail term = observe fail normalized))
+    [None; Some "a"; Some "b"; Some "c"]
+
+let expect term expected =
+  assert (Measure.fingerprint (Optimizer.normalize term) =
+          Measure.fingerprint expected)
+
+let () =
+  expect (Add (Int 2, Mul (Int 3, Int 4))) (Int 14);
+  expect (Equal (Int 2, Int 3)) (Bool false);
+  expect (Add (Int 0, Read "a")) (Read "a");
+  expect (Mul (Read "a", Int 1)) (Read "a");
+  expect (Mul (Int 0, Var Z)) (Int 0);
+  expect (Mul (Int 0, Read "a")) (Mul (Int 0, Read "a"));
+  expect (If (Bool true, Add (Int 4, Int 0), Read "a")) (Int 4);
+  expect (Fst (Pair (Int 4, Read "a"))) (Fst (Pair (Int 4, Read "a")));
+  expect (Snd (Pair (Read "a", Bool true))) (Snd (Pair (Read "a", Bool true)));
+  expect (Fst (Pair (Read "a", Bool true))) (Read "a");
+  expect (Snd (Pair (Bool false, Read "a"))) (Read "a");
+  expect (Let (Pair (Int 4, Pair (Bool true, Int 2)),
+                If (Fst (Snd (Var Z)), Fst (Var Z), Snd (Snd (Var Z)))))
+    (Int 4);
+  expect (Let (Int 4, Let (Read "b", Add (Var (S Z), Var Z))))
+    (Let (Read "b", Add (Int 4, Var Z)));
+  expect (Let (Read "a", Add (Var Z, Int 0))) (Let (Read "a", Var Z));
+  expect (Let (Read "a", Int 4)) (Let (Read "a", Int 4));
+  expect (Let (Add (Var Z, Int 2), Add (Var Z, Var Z)))
+    (Let (Add (Var Z, Int 2), Add (Var Z, Var Z)));
+  expect (Let (Var Z, Let (Read "a", Add (Var Z, Var (S (S Z))))))
+    (Let (Read "a", Add (Var Z, Var (S Z))));
+  expect (Let (Var Z, Let (Read "a", Add (Var Z, Var (S Z)))))
+    (Let (Var Z, Let (Read "a", Add (Var Z, Var (S Z)))));
+  check () (Let (Read "a", Pair (Var Z, Var Z)));
+  check () (Fst (Pair (Read "a", Read "b")));
+  check () (Snd (Pair (Read "b", Read "a")));
+  check () (If (Bool false, Read "a", Read "b"));
+  check (7, ()) (Let (Var Z, Let (Read "a", Add (Var Z, Var (S (S Z))))))
+
+(* Independent clients change both environment order and value types. *)
+let swap : type a. (int * (bool * unit), a) var ->
+    (bool * (int * unit), a) var = function
+  | Z -> S Z
+  | S Z -> Z
+  | S (S _) -> .
+
+let replacement : type a. (int * (bool * unit), a) var ->
+    (bool * (int * unit), a) t = function
+  | Z -> Add (Var (S Z), Int 1)
+  | S Z -> Var Z
+  | S (S _) -> .
+
+let () =
+  let term = Let (Read "a", Let (Bool false,
+    Pair (Add (Var (S (S Z)), Var (S Z)), Pair (Var Z, Var (S (S (S Z))))))) in
+  let read _ = 3 in
+  assert (Eval.run ~read (true, (7, ())) (Optimizer.rename { apply = swap } term)
+          = Eval.run ~read (7, (true, ())) term);
+  assert (Eval.run ~read (true, (7, ()))
+            (Optimizer.substitute { replace = replacement } term)
+          = Eval.run ~read (8, (true, ())) term);
+  let replace : type a. (int * unit, a) var -> (int * unit, a) t = function
+    | Z -> Add (Var Z, Int 1)
+    | S _ -> .
+  in
+  let simultaneous : (int * unit, int * unit) Optimizer.substitution =
+    { replace }
+  in
+  assert (Measure.fingerprint (Optimizer.substitute simultaneous (Var Z))
+          = "+(v0,i1)");
+  let nested = Let (Bool true, Let (Read "a", Var (S (S Z)))) in
+  assert (Measure.fingerprint (Optimizer.substitute simultaneous nested)
+          = "let(btrue,let(r\"a\",+(v2,i1)))");
+  assert (Measure.fingerprint (Optimizer.rename { apply = fun v -> S v } nested)
+          = "let(btrue,let(r\"a\",v3))")
+
+(* Deterministic typed programs exercise mixed effects and nested scopes. *)
+let random = Random.State.make [|413; 29|]
+let choose n = Random.State.int random n
+
+let rec integer : type env. int -> (env, int) var list -> (env, int) t =
+  fun depth vars ->
+    if depth = 0 then
+      match choose 3, vars with
+      | 0, _ :: _ -> Var (List.nth vars (choose (List.length vars)))
+      | 1, _ -> Read (List.nth ["a"; "b"; "c"] (choose 3))
+      | _ -> Int (choose 5 - 2)
+    else
+      let child () = integer (depth - 1) vars in
+      match choose 9 with
+      | 0 -> Add (child (), child ())
+      | 1 -> Mul (child (), child ())
+      | 2 -> If (boolean (depth - 1) vars, child (), child ())
+      | 3 -> Fst (Pair (child (), boolean (depth - 1) vars))
+      | 4 -> Snd (Pair (boolean (depth - 1) vars, child ()))
+      | 5 -> Let (child (), integer (depth - 1) (Z :: List.map (fun v -> S v) vars))
+      | 6 -> Let (Pair (child (), boolean (depth - 1) vars),
+                   Add (Fst (Var Z), integer (depth - 1) (List.map (fun v -> S v) vars)))
+      | 7 -> Mul (Int 0, child ())
+      | _ -> integer 0 vars
+and boolean : type env. int -> (env, int) var list -> (env, bool) t =
+  fun depth vars ->
+    if depth = 0 then Bool (choose 2 = 0)
+    else match choose 3 with
+      | 0 -> Equal (integer (depth - 1) vars, integer (depth - 1) vars)
+      | 1 -> If (boolean (depth - 1) vars,
+                  boolean (depth - 1) vars, boolean (depth - 1) vars)
+      | _ -> Let (integer (depth - 1) vars,
+                   boolean (depth - 1) (Z :: List.map (fun v -> S v) vars))
+
+let () =
+  for _ = 1 to 1000 do
+    check () (integer 4 []);
+    check (7, (-3, ())) (integer 4 [Z; S Z]);
+    check (true, (7, ())) (boolean 4 [S Z])
+  done
