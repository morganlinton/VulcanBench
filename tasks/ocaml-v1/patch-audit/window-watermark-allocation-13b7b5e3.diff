-type t = { width:int; mutable latest:int; mutable events:(int*int) list; mutable visits:int }
-let create ~width = if width<1 || width>4096 then invalid_arg "width"; {width;latest=(-1);events=[];visits=0}
+type t = {
+  width : int;
+  mutable latest : int;
+  sums : int array;
+  counts : int array;
+  mutable total : int;
+  mutable count : int;
+  mutable visits : int;
+}
+
+let create ~width =
+  if width < 1 || width > 4096 then invalid_arg "width";
+  { width; latest = -1; sums = Array.make width 0;
+    counts = Array.make width 0; total = 0; count = 0; visits = width }
+
+let clear t index =
+  t.total <- t.total - t.sums.(index);
+  t.count <- t.count - t.counts.(index);
+  t.sums.(index) <- 0;
+  t.counts.(index) <- 0;
+  t.visits <- t.visits + 1
+
 let add t ~time ~value =
-  if time<0 then Error "negative time" else if t.latest>=0 && time<Window_bounds.oldest ~width:t.width ~watermark:t.latest then Error "late event"
-  else begin t.latest<-max time t.latest; t.events<-(time,value)::t.events; t.visits<-t.visits+List.length t.events; Ok() end
-let total t = List.fold_left(fun acc (_,v)->acc+v) 0 t.events
-let count t = List.length t.events
-let watermark t = if t.latest<0 then None else Some t.latest
+  if time < 0 then Error "negative time"
+  else if t.latest >= 0 &&
+          time < Window_bounds.oldest ~width:t.width ~watermark:t.latest
+  then Error "late event"
+  else begin
+    if time > t.latest then begin
+      if t.latest >= 0 then begin
+        let advance = time - t.latest in
+        if advance >= t.width then
+          for index = 0 to t.width - 1 do clear t index done
+        else
+          (* Each newly entered timestamp reuses the bucket leaving the window. *)
+          for offset = 1 to advance do
+            clear t ((t.latest + offset) mod t.width)
+          done
+      end;
+      t.latest <- time
+    end;
+    let index = time mod t.width in
+    t.sums.(index) <- t.sums.(index) + value;
+    t.counts.(index) <- t.counts.(index) + 1;
+    t.total <- t.total + value;
+    t.count <- t.count + 1;
+    t.visits <- t.visits + 1;
+    Ok ()
+  end
+
+let total t = t.total
+let count t = t.count
+let watermark t = if t.latest < 0 then None else Some t.latest
 let bucket_visits t = t.visits
