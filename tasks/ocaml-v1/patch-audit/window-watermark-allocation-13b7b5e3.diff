diff --git a/public/window_test.ml b/public/window_test.ml
new file mode 100644
index 0000000..8697bd5
--- /dev/null
+++ b/public/window_test.ml
@@ -0,0 +1,95 @@
+let accept t time value = assert (Window.add t ~time ~value = Ok ())
+
+let snapshot t =
+  Window.watermark t, Window.count t, Window.total t, Window.bucket_visits t
+
+let reject t time error =
+  let before = snapshot t in
+  assert (Window.add t ~time ~value:123 = Error error);
+  assert (snapshot t = before)
+
+let () =
+  List.iter (fun width ->
+    match Window.create ~width with
+    | exception Invalid_argument _ -> ()
+    | _ -> assert false) [min_int; 0; 4097; max_int];
+  let t = Window.create ~width:3 in
+  reject t (-1) "negative time";
+  accept t 10 5;
+  accept t 8 2;
+  accept t 9 (-1);
+  assert (Window.count t = 3 && Window.total t = 6);
+  accept t 11 4;
+  assert (Window.count t = 3 && Window.total t = 8);
+  reject t 8 "late event";
+  accept t 9 (-3);
+  assert (Window.count t = 4 && Window.total t = 5);
+  let visits = Window.bucket_visits t in
+  accept t max_int 7;
+  assert (Window.bucket_visits t - visits = 4);
+  assert (Window.count t = 1 && Window.total t = 7);
+  accept t (max_int - 2) (-7);
+  reject t (max_int - 3) "late event";
+  reject t min_int "negative time";
+  assert (Window.watermark t = Some max_int);
+  assert (Window.count t = 2 && Window.total t = 0);
+  let t = Window.create ~width:3 in
+  accept t 0 4;
+  accept t 1 (-2);
+  accept t 2 3;
+  assert (Window.count t = 3 && Window.total t = 5);
+  accept t 3 1;
+  assert (Window.count t = 3 && Window.total t = 2);
+  reject t 0 "late event";
+  let t = Window.create ~width:3 in
+  accept t (max_int - 2) 1;
+  accept t (max_int - 1) 2;
+  accept t max_int 3;
+  assert (Window.count t = 3 && Window.total t = 6)
+
+(* Compare to an event-list model across wraparound, duplicates and jumps. *)
+let () =
+  let rng = Random.State.make [|42|] in
+  List.iter (fun width ->
+    let t = Window.create ~width in
+    let latest = ref (-1) and events = ref [] in
+    for step = 0 to 1999 do
+      let time =
+        if step mod 17 = 0 then !latest + width + 3
+        else max 0 (!latest + Random.State.int rng (width + 5) - width)
+      in
+      let value = Random.State.int rng 101 - 50 in
+      if time < max 0 (!latest - (width - 1)) then reject t time "late event"
+      else begin
+        let before = Window.bucket_visits t in
+        let advance = if !latest < 0 then 0 else max 0 (time - !latest) in
+        accept t time value;
+        assert (Window.bucket_visits t - before = min width advance + 1);
+        latest := max time !latest;
+        events := List.filter (fun (timestamp, _) ->
+          timestamp >= max 0 (!latest - (width - 1))) ((time, value) :: !events);
+        assert (Window.watermark t = Some !latest);
+        assert (Window.count t = List.length !events);
+        assert (Window.total t = List.fold_left (fun sum (_, v) -> sum + v) 0 !events)
+      end
+    done) [1; 3; 64; 4096]
+
+(* Measure the warmed native insertion path without allocating test data. *)
+let () =
+  List.iter (fun width ->
+    let t = Window.create ~width in
+    for time = 0 to width do accept t time 1 done;
+    let n = 100_000 in
+    let before = Gc.allocated_bytes () in
+    for time = width + 1 to width + n do
+      accept t time (-1);
+      accept t time 2;
+      accept t (time - width + 1) (-1)
+    done;
+    let bytes = Gc.allocated_bytes () -. before in
+    let per_event = bytes /. float_of_int (3 * n) in
+    Printf.printf "width=%d: %.3f allocated bytes/event\n%!" width per_event;
+    assert (per_event < 32.);
+    assert (Window.bucket_visits t <= 3 * (3 * n + width + 1) + 2 * width);
+    assert (Window.count t = 2 * width + 1);
+    assert (Window.total t = width - 1)) [1; 4096]
