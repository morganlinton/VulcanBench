diff --git a/public/smoke.ml b/public/smoke.ml
index 26185ed..ad1c6da 100644
--- a/public/smoke.ml
+++ b/public/smoke.ml
@@ -1 +1,91 @@
-let () = let t=Window.create ~width:4 in assert(Window.count t=0); assert(Window.total t=0); assert(Window.watermark t=None); assert(Window.add t ~time:(-1) ~value:5=Error "negative time")
+let snapshot t =
+  Window.count t, Window.total t, Window.watermark t, Window.bucket_visits t
+
+let accept t time value = assert (Window.add t ~time ~value = Ok ())
+
+let reject t time error =
+  let before = snapshot t in
+  assert (Window.add t ~time ~value:99 = Error error);
+  assert (snapshot t = before)
+
+let () =
+  List.iter (fun width ->
+    match Window.create ~width with
+    | _ -> assert false
+    | exception Invalid_argument _ -> ()) [min_int; -1; 0; 4097; max_int];
+  let t = Window.create ~width:3 in
+  assert (Window.count t = 0 && Window.total t = 0);
+  assert (Window.watermark t = None);
+  reject t (-1) "negative time";
+  accept t 10 5;
+  accept t 8 2;
+  accept t 9 (-1);
+  assert (Window.count t = 3 && Window.total t = 6);
+  accept t 11 4;
+  assert (Window.count t = 3 && Window.total t = 8);
+  reject t 8 "late event";
+  reject t (-1) "negative time";
+  accept t 9 (-4);
+  assert (Window.count t = 4 && Window.total t = 4);
+  let visits = Window.bucket_visits t in
+  accept t max_int (-7);
+  assert (Window.bucket_visits t - visits = 4);
+  assert (Window.count t = 1 && Window.total t = -7);
+  accept t (max_int - 2) 3;
+  reject t (max_int - 3) "late event";
+  assert (Window.watermark t = Some max_int);
+  let t = Window.create ~width:4 in
+  accept t 0 1;
+  let visits = Window.bucket_visits t in
+  accept t 2 2;
+  assert (Window.bucket_visits t - visits = 3);
+  accept t 0 3;
+  accept t 4 4;
+  assert (Window.count t = 2 && Window.total t = 6)
+
+(* Compare against an event-list model, including rejections and ring reuse. *)
+let () =
+  let rng = Random.State.make [| 42 |] in
+  List.iter (fun width ->
+    let t = Window.create ~width in
+    let latest = ref (-1) and events = ref [] in
+    for _ = 1 to 3000 do
+      let time = !latest + Random.State.int rng (2 * width + 5) - width in
+      let value = Random.State.int rng 21 - 10 in
+      let before = snapshot t in
+      let expected =
+        if time < 0 then Error "negative time"
+        else if time < max 0 (!latest - width + 1) then Error "late event"
+        else begin
+          latest := max !latest time;
+          events := (time, value) :: List.filter
+            (fun (timestamp, _) -> timestamp >= max 0 (!latest - width + 1))
+            !events;
+          Ok ()
+        end
+      in
+      assert (Window.add t ~time ~value = expected);
+      if expected <> Ok () then assert (snapshot t = before);
+      assert (Window.count t = List.length !events);
+      assert (Window.total t = List.fold_left (fun sum (_, v) -> sum + v) 0 !events);
+      assert (Window.watermark t = if !latest < 0 then None else Some !latest)
+    done) [1; 3; 16; 4096]
+
+let () =
+  assert (Sys.backend_type = Sys.Native);
+  List.iter (fun width ->
+    let t = Window.create ~width in
+    for time = 0 to 2 * width do accept t time 1 done;
+    let n = 100_000 in
+    let visits = Window.bucket_visits t in
+    let before = Gc.allocated_bytes () in
+    for step = 1 to n do
+      accept t (2 * width + step) (-1)
+    done;
+    let bytes = Gc.allocated_bytes () -. before in
+    assert (bytes /. float_of_int n < 32.);
+    assert (Window.bucket_visits t - visits = 2 * n);
+    assert (Window.bucket_visits t <= 3 * (n + 2 * width + 1) + 2 * width);
+    assert (Window.count t = width && Window.total t = -width);
+    Printf.printf "width=%d: %.3f allocated bytes/event\n"
+      width (bytes /. float_of_int n)) [1; 3; 4096]
