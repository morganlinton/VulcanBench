+type t = { width:int; mutable latest:int; sums:int array; counts:int array; mutable sum:int; mutable n:int; mutable visits:int }
+let create ~width = if width<1 || width>4096 then invalid_arg "width";
+  {width;latest=(-1);sums=Array.make width 0;counts=Array.make width 0;sum=0;n=0;visits=0}
+let clear t i = t.sum<-t.sum-t.sums.(i); t.n<-t.n-t.counts.(i); t.sums.(i)<-0; t.counts.(i)<-0; t.visits<-t.visits+1
 let add t ~time ~value =
