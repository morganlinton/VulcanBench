+def _fgets_chunks(stream: str):
+    """Split a text stream the way the engine's buffered reads do."""
+    pos = 0
+    end = len(stream)
+    if end == 0:
+        yield ""
+        return
+    while pos < end:
+        stop = min(pos + _READ_CHUNK, end)
+        newline = stream.find("\n", pos, stop)
+        if newline == -1:
+            if stop == end:
+                yield stream[pos:]
+                return
+            yield stream[pos:stop]
+            pos = stop
+        else:
+            yield stream[pos : newline + 1]
+            pos = newline + 1
+
