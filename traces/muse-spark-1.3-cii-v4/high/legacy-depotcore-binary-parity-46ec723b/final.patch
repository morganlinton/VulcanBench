+def _bounce_penalty(bounces):
+    if bounces <= 0:
+        return 0
+    if bounces == 1:
+        return 35
+    return 35 * bounces - 10
+
+
+def _dispatch_key(p):
+    key = p.heft + p.seniority - _bounce_penalty(p.bounces)
+    if p.sender_idx % 3 == 2:
