+def _is_key(tok: bytes) -> bool:
+    return 1 <= len(tok) <= 8 and tok.isalnum()
+
+
+def _blocks(n: int) -> int:
+    if n <= 0:
+        return 0
+    return (n + 99) // 100 - (1 if n % 100 == 50 else 0)
 
 
