+from fuzz_fit import parse
+from scan_h import replay2
+import subprocess
+
+TMP = os.environ["TMPDIR"]
+VOBS = []
+for path in (f"{TMP}/fz11.txt", f"{TMP}/ft2.txt"):
+    for cmds, outs in parse(path):
+        try:
+            for n, c in replay2(cmds, outs):
