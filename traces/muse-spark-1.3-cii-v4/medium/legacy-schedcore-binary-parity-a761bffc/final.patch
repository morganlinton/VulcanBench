+    def _better(self, j: Job, best: Job) -> bool:
+        ej, eb = self._eff(j), self._eff(best)
+        if ej != eb:
+            return ej > eb
+        bj, bb = self._boost(j), self._boost(best)
+        if bj != bb:
+            return bj > bb
+        if j.torn != best.torn:
+            return j.torn > best.torn
+        return j.defseq < best.defseq
+
