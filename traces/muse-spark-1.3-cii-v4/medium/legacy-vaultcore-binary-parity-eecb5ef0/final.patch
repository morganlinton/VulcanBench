+def migrate_sweep(body: str) -> str:
+    """Migrate a v1 body on the bulk sweep path (and on the lazy read
+    path for a document whose current v1 body was itself written over a
+    previous v1 body): uppercase, strip trailing digits, and truncate to
+    18 characters when still at the 20-character maximum."""
+    swept = body.upper().rstrip(_DIGITS)
+    if len(swept) == BODY_MAX:
+        swept = swept[:_BULK_MAX]
+    return swept
+
