+def _is_digits(token: bytes) -> bool:
+    return len(token) > 0 and all(48 <= c <= 57 for c in token)
+
+
+def _is_alnum_ascii(token: bytes) -> bool:
+    return len(token) > 0 and all(
+        48 <= c <= 57 or 65 <= c <= 90 or 97 <= c <= 122 for c in token
+    )
+
