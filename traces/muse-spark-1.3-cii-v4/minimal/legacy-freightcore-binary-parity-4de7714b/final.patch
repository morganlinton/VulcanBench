+def _split_tokens(chunk: bytes) -> list[bytes]:
+    tokens: list[bytes] = []
+    current = bytearray()
+    for byte in chunk:
+        if byte in (32, 9, 13, 10):
+            if current:
+                tokens.append(bytes(current))
+                current = bytearray()
+        else:
+            current.append(byte)
+    if current:
+        tokens.append(bytes(current))
+    return tokens
 
 
