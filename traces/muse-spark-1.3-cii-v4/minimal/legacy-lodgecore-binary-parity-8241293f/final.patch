+S
+"""
+
+TWO_SEASON_TIE_OUT = """OK 1
+OK 2
+OK 1
+OK 2
+OK 3
+OK 1
+OK 2
+IN R
+IN R
+AIRED R 2
+MV a T
+MV b X
