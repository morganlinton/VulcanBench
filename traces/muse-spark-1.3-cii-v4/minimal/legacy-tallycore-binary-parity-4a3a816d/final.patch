+    def _reg_victim(
+        self, alive: list[bool], tally: list[int], last: bool
+    ) -> int:
+        # smallest tally, first- or last-registered among the tied
+        low = min(t for c, t in enumerate(tally) if alive[c])
+        best = [
+            c for c in range(len(self.cands)) if alive[c] and tally[c] == low
+        ]
+        return best[-1] if last else best[0]
